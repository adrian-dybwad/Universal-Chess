#!/usr/bin/bash

# The install directory is intentionally NOT the Debian package name: the package
# is "universal-chess" but the tree is installed under /opt/universalchess (see
# scripts/build.sh OPT_DIR_NAME). Deriving the path from the package name (the
# inherited "/opt/${PACKAGE}" idiom) produced /opt/universal-chess -- a path that
# never existed -- so this cleanup silently no-op'd and `find` logged
# "No such file or directory" on every upgrade/remove.
INSTALL_DIR="/opt/universalchess"

function removePycache {
    # Runtime-generated bytecode caches and the debug frame image are not shipped
    # in the .deb, so dpkg never removes them; prune them here. Guard on the
    # directory so a missing tree is a no-op rather than a `find` error, and use
    # -exec so an empty match does not invoke rm with no operands.
    [ -d "${INSTALL_DIR}" ] || return 0
    find "${INSTALL_DIR}" -depth \
        \( -name '__pycache__' -o -name '*.pyc' -o -name '*.pyo' -o -name 'epaper.jpg' \) \
        -exec rm -rf {} + 2>/dev/null || true
}


function stopServices {
    # Stop services in reverse dependency order
    # Use || true to prevent failures from aborting the upgrade
    systemctl stop universal-chess.service || true
    systemctl stop universal-chess-web.service || true
    systemctl stop universal-chess-stop-controller.service || true
    systemctl stop var-run-sdp.path || true
    systemctl stop var-run-sdp.service || true
    # Stop the hostname-watch path first so it cannot re-trigger cert
    # generation while package files are being replaced during an upgrade.
    systemctl stop universal-chess-tls.path || true
    systemctl stop universal-chess-tls.service || true
    systemctl stop rfcomm.service || true
}


case $1 in
    remove* | upgrade )
        echo "::: Stopping services before $1..."
        stopServices || true
        removePycache
        exit 0
        ;;
esac
