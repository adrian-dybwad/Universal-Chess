    chmod 440 "$SET_TZ_SUDOERS_FILE"
    # Validate before it can take effect; a malformed drop-in can lock out sudo.
    if ! visudo -cf "$SET_TZ_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: timezone sudoers entry invalid; removing"
        rm -f "$SET_TZ_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: timezone helper not found at $SET_TZ_HELPER"
fi

# Allow the service user to manage the device clock from the web/board Settings:
# turning network time sync on or off, and -- when it is off -- stepping the
# clock to a time supplied by the browser. Both are `timedatectl` operations and
# root-only. As with the timezone helper, grant passwordless sudo to exactly one
# pinned helper; its verb `case` and per-verb argument validation are the
# boundary, so the grant cannot become an arbitrary-command primitive. Without it
# the toggle and the clock-set action report "not applied".
#
# This matters most on a board reached only over the USB gadget link, which has
# no time source at all: without a way to set the clock by hand its wall time
# stays wherever it landed at boot.
echo -e "::: Configuring sudoers for the device clock"
CLOCK_ADMIN_HELPER="${DGTCM_PATH}/scripts/uc-clock-admin"
if [ -f "$CLOCK_ADMIN_HELPER" ]; then
    chmod +x "$CLOCK_ADMIN_HELPER"
    CLOCK_ADMIN_SUDOERS_FILE="/etc/sudoers.d/universal-chess-clock"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $CLOCK_ADMIN_HELPER" > "$CLOCK_ADMIN_SUDOERS_FILE"
    chmod 440 "$CLOCK_ADMIN_SUDOERS_FILE"
    # Validate before it can take effect; a malformed drop-in can lock out sudo.
    if ! visudo -cf "$CLOCK_ADMIN_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: device clock sudoers entry invalid; removing"
        rm -f "$CLOCK_ADMIN_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: device clock helper not found at $CLOCK_ADMIN_HELPER"
fi

# USB Ethernet gadget mode (off / auto / client / shared) goes through Raspberry Pi's
# rpi-usb-gadget tool, which is root-only. Grant passwordless sudo to exactly
# this pinned helper; its verb case is the boundary. Without it the System
# select reports "not applied".
echo -e "::: Configuring sudoers for USB gadget mode"
USB_GADGET_ADMIN_HELPER="${DGTCM_PATH}/scripts/uc-usb-gadget-admin"
if [ -f "$USB_GADGET_ADMIN_HELPER" ]; then
    chmod +x "$USB_GADGET_ADMIN_HELPER"
    USB_GADGET_ADMIN_SUDOERS_FILE="/etc/sudoers.d/universal-chess-usb-gadget"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $USB_GADGET_ADMIN_HELPER" > "$USB_GADGET_ADMIN_SUDOERS_FILE"
    chmod 440 "$USB_GADGET_ADMIN_SUDOERS_FILE"
    if ! visudo -cf "$USB_GADGET_ADMIN_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: USB gadget sudoers entry invalid; removing"
        rm -f "$USB_GADGET_ADMIN_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: USB gadget helper not found at $USB_GADGET_ADMIN_HELPER"
fi
# NetworkManager ships a udev rule marking gadget interfaces unmanaged, which
# leaves usb0 with no address once Client/Shared apply moves netplan-eth0 aside.
# The drop-in claims usb0; reload so it applies without waiting for a reboot.
if [ -f /etc/NetworkManager/conf.d/90-uc-usb-gadget-managed.conf ] && command -v nmcli >/dev/null 2>&1; then
    nmcli general reload conf >/dev/null 2>&1 || true
fi

# Allow the service user to loop-mount an uploaded Centaur SD image read-only
# during import. `mount` is a general primitive (any device/target/options), so
# granting it directly would let the service mount arbitrary filesystems
# anywhere. As with bt-admin and the updater, grant passwordless sudo to exactly
# one pinned helper that mounts only a caller-supplied image -- read-only,
# nodev/nosuid/noexec -- at one fixed mountpoint and unmounts it; its `case` plus
# path allow-list are the boundary. Without this grant the SD import cannot read
# the ext4 image and Original Centaur stays uninstallable.
echo -e "::: Configuring sudoers for Centaur import"
CENTAUR_MOUNT_HELPER="${DGTCM_PATH}/scripts/centaur-import-mount"
if [ -f "$CENTAUR_MOUNT_HELPER" ]; then
    chmod +x "$CENTAUR_MOUNT_HELPER"
    CENTAUR_MOUNT_SUDOERS_FILE="/etc/sudoers.d/universal-chess-centaur-import"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $CENTAUR_MOUNT_HELPER" > "$CENTAUR_MOUNT_SUDOERS_FILE"
    chmod 440 "$CENTAUR_MOUNT_SUDOERS_FILE"
    # Validate before it can take effect; a malformed drop-in can lock out sudo.
    if ! visudo -cf "$CENTAUR_MOUNT_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: centaur-import sudoers entry invalid; removing"
        rm -f "$CENTAUR_MOUNT_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: centaur-import helper not found at $CENTAUR_MOUNT_HELPER"
fi

# Grant the pinned centaur-armhf helper. The imported Centaur binary is a 32-bit
# armhf ELF; on a 64-bit (arm64) host it cannot exec until the armhf foreign
# architecture is enabled and libc6:armhf is installed, and its display shim
# cannot be built until the armhf cross toolchain is installed. Enabling a foreign
# architecture is a system reconfiguration apt cannot do while resolving package
# Depends, so the SD import performs it at import time via this helper. The helper
# hard-codes the architecture and package set (no caller input), so the grant
# cannot become a general apt-install primitive.
echo -e "::: Configuring sudoers for Centaur armhf support"
ARMHF_SETUP_HELPER="${DGTCM_PATH}/scripts/centaur-armhf-setup"
if [ -f "$ARMHF_SETUP_HELPER" ]; then
    chmod +x "$ARMHF_SETUP_HELPER"
    ARMHF_SETUP_SUDOERS_FILE="/etc/sudoers.d/universal-chess-armhf-setup"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $ARMHF_SETUP_HELPER" > "$ARMHF_SETUP_SUDOERS_FILE"
    chmod 440 "$ARMHF_SETUP_SUDOERS_FILE"
    # Validate before it can take effect; a malformed drop-in can lock out sudo.
    if ! visudo -cf "$ARMHF_SETUP_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: armhf-setup sudoers entry invalid; removing"
        rm -f "$ARMHF_SETUP_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: centaur-armhf helper not found at $ARMHF_SETUP_HELPER"
fi

# Grant the pinned engine-dependency helper. Most engines build with the
# toolchain this package already Depends on (build-essential, git), but a few
# need more -- Zahak needs golang, Arasan needs clang -- and those are hundreds
# of megabytes the vast majority of boards never use, so they are installed on
# demand instead of being pulled onto every board. The helper hard-codes an
# allow-list of exactly the packages the engine catalog declares and refuses
# anything else, so the grant cannot become a general apt-install primitive.
# Without it, installing those engines fails on any board lacking blanket
# passwordless sudo (the "a terminal is required to read the password" error).
echo -e "::: Configuring sudoers for engine dependencies"
ENGINE_DEPS_HELPER="${DGTCM_PATH}/scripts/uc-engine-deps"
if [ -f "$ENGINE_DEPS_HELPER" ]; then
    chmod +x "$ENGINE_DEPS_HELPER"
    ENGINE_DEPS_SUDOERS_FILE="/etc/sudoers.d/universal-chess-engine-deps"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $ENGINE_DEPS_HELPER" > "$ENGINE_DEPS_SUDOERS_FILE"
    chmod 440 "$ENGINE_DEPS_SUDOERS_FILE"
    # Validate before it can take effect; a malformed drop-in can lock out sudo.
    if ! visudo -cf "$ENGINE_DEPS_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: engine-deps sudoers entry invalid; removing"
        rm -f "$ENGINE_DEPS_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: engine deps helper not found at $ENGINE_DEPS_HELPER"
fi

# Allow the service user to refresh Raspberry Pi OS packages from Settings.
# `apt-get update && apt-get upgrade` needs root, but granting NOPASSWD on apt
# is unrestricted root (`apt-get install` accepts any package). As with the
# other helpers, grant passwordless sudo to exactly this one pinned script,
# whose verb case (check / apply only) is the boundary. Without it the
# Software Updates card cannot move the OS on a board that is never SSHed into.
echo -e "::: Configuring sudoers for OS package upgrades"
OS_UPGRADE_HELPER="${DGTCM_PATH}/scripts/uc-os-upgrade"
if [ -f "$OS_UPGRADE_HELPER" ]; then
    chmod +x "$OS_UPGRADE_HELPER"
    OS_UPGRADE_SUDOERS_FILE="/etc/sudoers.d/universal-chess-os-upgrade"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $OS_UPGRADE_HELPER" > "$OS_UPGRADE_SUDOERS_FILE"
    chmod 440 "$OS_UPGRADE_SUDOERS_FILE"
    if ! visudo -cf "$OS_UPGRADE_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: os-upgrade sudoers entry invalid; removing"
        rm -f "$OS_UPGRADE_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: os-upgrade helper not found at $OS_UPGRADE_HELPER"
fi

# Undo the armhf cross toolchain this package used to recommend onto every board.
# gcc-arm-linux-gnueabihf + libc6-dev-armhf-cross are only usable on arm64, where
# Centaur's 32-bit display shim must be cross-compiled; centaur-armhf-setup above
# installs them there on demand. On an ARMv6 board (Pi Zero W, Pi 1) the cross
# package's ARMv7 crt objects under /usr/arm-linux-gnueabihf/lib shadow the native
# ones on gcc's search path, so every locally linked binary segfaults before main
# -- every engine built from source crashed at startup while its binary sat on
# disk looking installed. The Recommends is gone, which fixes new installs; this
# unit heals boards that already carry the packages.
#
# It must be a unit rather than an inline apt-get: this postinst holds the dpkg
# frontend lock, so removing packages here would deadlock. The helper waits for
# that lock, so starting the unit --no-block lets the repair land on this update
# instead of the next boot, without blocking the install on our own lock.
echo -e "::: Removing unusable armhf cross toolchain"
ARMHF_CLEANUP_HELPER="${DGTCM_PATH}/scripts/uc-drop-armhf-cross"
if [ -f "$ARMHF_CLEANUP_HELPER" ]; then
    chmod +x "$ARMHF_CLEANUP_HELPER"
    systemctl daemon-reload
    systemctl enable universal-chess-armhf-cleanup.service 2>/dev/null || true
    systemctl start --no-block universal-chess-armhf-cleanup.service 2>/dev/null || true
else
    echo -e "::: Warning: armhf-cleanup helper not found at $ARMHF_CLEANUP_HELPER"
fi

# Allow the service user to restart Universal Chess without a password. Returning
# from the original Centaur software brings the board back by restarting its own
# unit: the on-board path (services/power.py RESTART_UNIVERSAL_CHESS_CMD) and the
# web /api/system/return-to-universal endpoint both run
# `sudo systemctl restart universal-chess.service`. A stock board has no
# passwordless sudo, so that command is denied and the board stays dead after
# Original Centaur (the regression this grant fixes). Grant passwordless sudo to
# exactly that one restart command -- pinned with its arguments so it is not a
# blanket `systemctl` (start/stop/mask any unit) grant. `systemctl` is addressed
# by absolute path because sudo authorizes by the resolved command path. Both
# universal-chess.service and universal-chess-web.service run as $PRIMARY_USER, so
# this single grant covers both return paths. (The app also has a privilege-free
# fallback -- exiting non-zero so Restart=on-failure recovers it -- but this grant
# makes the intended in-place restart work directly.)
echo -e "::: Configuring sudoers for service restart"
RESTART_SUDOERS_FILE="/etc/sudoers.d/universal-chess-restart"
echo "$PRIMARY_USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart universal-chess.service" > "$RESTART_SUDOERS_FILE"
chmod 440 "$RESTART_SUDOERS_FILE"
# Validate before it can take effect; a malformed drop-in can lock out sudo.
if ! visudo -cf "$RESTART_SUDOERS_FILE" >/dev/null 2>&1; then
    echo -e "::: Warning: service-restart sudoers entry invalid; removing"
    rm -f "$RESTART_SUDOERS_FILE"
fi

# Allow the service user to reboot and power off the machine. The Power menu and
# the web Power controls both end in platform/system_power.py running
# `sudo systemctl reboot` / `sudo systemctl poweroff`. Neither was granted, so on
# a board without a blanket NOPASSWD rule sudo asked for a password, found no TTY
# under the service and denied the command: the Pi stayed up while the app
# finished its cleanup and exited, which looked like the menu had merely killed
# the board app. Each verb is pinned with its argument -- a bare `systemctl`
# grant would be root over every unit -- and `systemctl` is addressed by absolute
# path because sudo authorizes by the resolved command path. Kept in its own
# drop-in: the restart grant above is written with `>`, so sharing that file
# would erase these lines whenever it is rewritten.
echo -e "::: Configuring sudoers for power actions"
POWER_SUDOERS_FILE="/etc/sudoers.d/universal-chess-power"
{
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: /usr/bin/systemctl reboot"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff"
} > "$POWER_SUDOERS_FILE"
chmod 440 "$POWER_SUDOERS_FILE"
# Validate before it can take effect; a malformed drop-in can lock out sudo.
if ! visudo -cf "$POWER_SUDOERS_FILE" >/dev/null 2>&1; then
    echo -e "::: Warning: power sudoers entry invalid; removing"
    rm -f "$POWER_SUDOERS_FILE"
fi

# Persistent application event log (services.event_log). Pre-create the log dir
# and file owned by the service user so: (a) the app (running as that user)
# can append AND rotate it (rotation renames within the dir, needing dir
# ownership), and (b) the root-run BlueZ self-heal can append via the event_log
# CLI (root bypasses file permissions). Without pre-creation, whichever producer
# writes first sets ownership -- and if that is the root self-heal at first boot,
# the service user could no longer write. Kept under /var/lib (FHS state) so it
# survives app reinstalls, like the bluez marker.
echo -e "::: Provisioning application event log"
EVENT_LOG_DIR="/var/lib/universalchess/logs"
EVENT_LOG_FILE="${EVENT_LOG_DIR}/events.jsonl"
mkdir -p "$EVENT_LOG_DIR"
touch "$EVENT_LOG_FILE"
chown "$PRIMARY_USER":"$PRIMARY_USER" "$EVENT_LOG_DIR" "$EVENT_LOG_FILE" 2>/dev/null || \
    chown "$PRIMARY_USER" "$EVENT_LOG_DIR" "$EVENT_LOG_FILE" 2>/dev/null || true
chmod 664 "$EVENT_LOG_FILE"

# BlueZ advertising self-heal: keep BLE advertising working across OS/kernel
# updates by substituting a minimally-patched bluetoothd only when the stock one
# is broken (kernel 6.18 ext-adv-data validation vs released-BlueZ sizeof bug),
# and retiring it once the distro ships the fix. The heavy work (probe + build +
# dpkg-divert) runs in a oneshot unit triggered AFTER apt releases its lock --
# never inline here (apt/dpkg from a maintainer script would deadlock). See
# scripts/bluez-selfheal and docs/bluetooth/bluez-self-heal.md.
echo -e "::: Configuring BlueZ advertising self-heal"
mkdir -p /var/lib/universalchess
for s in bluez-selfheal bluez-advertising-probe; do
    [ -f "${DGTCM_PATH}/scripts/$s" ] && chmod +x "${DGTCM_PATH}/scripts/$s"
done

# nginx HTTPS proxy + TLS certificate are set up later in the configure case
# (after the venv is built and the hostname is finalized), via
# enable-web-proxy.sh. Generating here -- before the venv exists and before the
# hostname is updated -- would issue a certificate for the wrong name. The
# boot-time universal-chess-tls.service then regenerates it for the final
# hostname before nginx starts.

# Install dhcpcd hook for WiFi status widget
echo -e "::: Installing dhcpcd hook for WiFi status widget"
    if [ -f "${DGTCM_PATH}/../etc/dhcpcd/dhcpcd-hooks/50-dgtcm-wifi-notify" ]; then
        sudo mkdir -p /lib/dhcpcd/dhcpcd-hooks
        sudo cp "${DGTCM_PATH}/../etc/dhcpcd/dhcpcd-hooks/50-dgtcm-wifi-notify" /lib/dhcpcd/dhcpcd-hooks/
        sudo chmod +x /lib/dhcpcd/dhcpcd-hooks/50-dgtcm-wifi-notify
        # Create notification file directory
        sudo mkdir -p /var/run
        sudo touch /var/run/dgtcm-wifi-hook-notify
        sudo chmod 666 /var/run/dgtcm-wifi-hook-notify
    else
        echo -e "::: Warning: dhcpcd hook script not found"
    fi

# Update main.conf in /etc/bluetooth
    cp $BTMAIN $BTMAIN.bak
    sed -i "/DiscoverableTimeout/s/^# *//" $BTMAIN
    sed -i "/PairableTimeout/s/^# *//" $BTMAIN
    sed -i "s/#JustWorksRepairing = never/JustWorksRepairing = always/g" $BTMAIN
    
    # Set Bluetooth Class of Device to Audio/Video (headphones icon) to match real Millennium board
    # Class 0x200404 = Service Class (Audio) + Major Class (Audio/Video) + Minor Class (Headphones)
    if grep -q "^#Class = " $BTMAIN; then
        # Uncomment and set the Class line
        sed -i "s/^#Class = .*/Class = 0x200404/" $BTMAIN
    elif grep -q "^Class = " $BTMAIN; then
        # Update existing Class line
        sed -i "s/^Class = .*/Class = 0x200404/" $BTMAIN
    else
        # Add Class line under [General] section
        sed -i "/^\[General\]/a Class = 0x200404" $BTMAIN
    fi
    echo -e "::: Bluetooth Class set to 0x200404 (Audio/Video - headphones icon)"
    
    #Mark file as changed
    sed -i "$ a #dgtcentaurmods" $BTMAIN

systemctl daemon-reload

function update_hostname {
#Do not update unless hostname is still the default one.
if [ $(hostname) = $DEFAULT_HOSTNAME ]
then
    sed -i "s/$DEFAULT_HOSTNAME/$NEW_HOSTNAME/g" /etc/hosts
    sed -i "s/$DEFAULT_HOSTNAME/$NEW_HOSTNAME/g" /etc/hostname
fi
}

# Install Stockfish from system package and create symlink
# Create required directories
echo -e "::: Creating required directories"
mkdir -p "${DGTCM_PATH}/tmp"
mkdir -p "${DGTCM_PATH}/db"
mkdir -p "${DGTCM_PATH}/config"
grantRuntimeDataOwnership

# This ensures we get the correct architecture binary automatically
echo -e "::: Setting up Stockfish engine"
ENGINES_DIR="${DGTCM_PATH}/engines"
mkdir -p "${ENGINES_DIR}"

# Remove old compiled binaries and symlinks
rm -f "${ENGINES_DIR}/${STOCKFISH}"
# Remove old _pi named binaries from previous versions
rm -f "${ENGINES_DIR}/stockfish_pi"
rm -f "${ENGINES_DIR}/stockfish_pi_arm64"
rm -f "${ENGINES_DIR}/stockfish_pi_armhf"

# NOTE:
# Do NOT run apt/apt-get from maintainer scripts. During installation, dpkg/apt
# may already hold the frontend lock, which will make apt-get calls fail and
# break installation.
#
# Stockfish should be declared as a dependency in DEBIAN/control. If it is not
# present, print a warning and continue.
if command -v stockfish &> /dev/null; then
    STOCKFISH_PATH=$(command -v stockfish)
elif [ -x "/usr/games/stockfish" ]; then
    STOCKFISH_PATH="/usr/games/stockfish"
elif [ -x "/usr/bin/stockfish" ]; then
    STOCKFISH_PATH="/usr/bin/stockfish"
else
    STOCKFISH_PATH=""
fi

if [ -n "${STOCKFISH_PATH}" ]; then
    echo -e "::: Found system Stockfish at ${STOCKFISH_PATH}"
    ln -sfn "${STOCKFISH_PATH}" "${ENGINES_DIR}/${STOCKFISH}"
    chown -h "$PRIMARY_USER:$PRIMARY_USER" "${ENGINES_DIR}/${STOCKFISH}" 2>/dev/null || true
    echo -e "::: Created symlink ${ENGINES_DIR}/${STOCKFISH} -> ${STOCKFISH_PATH}"
else
    echo -e "::: WARNING: Stockfish not found on PATH. Install it with: sudo apt-get install -y stockfish"
fi

#
#echo -e "::: Installing python packages."
#    cd $DGTCM_PATH
#    CFLAGS="-fcommon" pip3 install -r $DGTCM_PATH/setup/requirements.txt
echo -e "::: Installing python packages"

export DEBIAN_FRONTEND=noninteractive

# Create venv if missing
if [ ! -x "$VENV_DIR/bin/python" ]; then
  python3 -m venv --system-site-packages "$VENV_DIR"
fi

# pip and wheel are deliberately NOT upgraded here. Doing so downloaded whatever
# PyPI served at that moment and ran it as root on every install -- the same
# exposure the signed-update work removes from the package -- and bought nothing:
# the venv already provides pip, and installing a prebuilt wheel needs neither a
# newer pip nor the wheel package. It also made an install on an offline board
# fail at this line instead of somewhere diagnosable.

# Install the venv's packages from the wheels carried inside this package.
#
# --no-index with no fallback is deliberate. The alternative -- reaching PyPI
# when the wheelhouse looks absent -- would run whatever the index served, as
# root, at install time, and would do it silently on exactly the boards where
# something is already wrong. scripts/build.sh refuses to produce a package
# without a wheelhouse, so getting here without one means the package is
# damaged, and failing loudly is the only useful response.
#
# Requirements that Debian supplies (see setup/system-provided.txt) are already
# importable through --system-site-packages, so pip treats them as satisfied and
# never looks for a wheel; the wheelhouse holds only the rest.
if [ -f "$REQ_VENV" ]; then
  if [ ! -d "$WHEELS_DIR" ]; then
    echo -e "::: ERROR: vendored wheelhouse missing at $WHEELS_DIR"
    echo -e "::: This package cannot install its Python dependencies. Reinstall"
    echo -e "::: from a complete .deb; the install is deliberately not falling"
    echo -e "::: back to downloading them as root."
    exit 1
  fi
  "$VENV_DIR/bin/pip" install --no-index --find-links "$WHEELS_DIR" -r "$REQ_VENV"
fi

# Build the Centaur display "translate" shim now if Centaur is already installed.
# The shim (spishim.so) is LD_PRELOADed into centaur to virtualize its panel and
# forward its frames to UC; it must be compiled natively (32-bit ARM ABI), so it
# is built on-device from the shipped source and never prebuilt. Built here as
# the service user so it lands in that user's ~/centaur owned by them (where the
# launcher reads it). Skipped when Centaur is not yet imported -- the translate
# launch path builds it on demand after a later import. Non-fatal: a missing
# toolchain or compile error must not fail the package install; the launch path
# rebuilds and reports loudly if the shim is still absent.
echo -e "::: Building Centaur display shim (translate mode)"
if [ -f "${CENTAUR}centaur" ]; then
    if command -v runuser >/dev/null 2>&1; then
        runuser -u "$PRIMARY_USER" -- env PYTHONPATH="$PACKAGES_PATH" \
            "$VENV_DIR/bin/python" -m universalchess.services.centaur_display.shim_builder \
            || echo -e "::: Warning: Centaur display shim build failed (translate mode will rebuild on launch)"
    else
        echo -e "::: Warning: runuser unavailable; skipping shim prebuild (built on first translate launch)"
    fi
else
    echo -e "::: Centaur not installed yet; display shim will be built on first translate launch"
fi

# Note: Additional engines (ct800, rodentIV, zahak, maia) can be installed
# from the Engine Manager in Settings -> Engine Manager on the board.
# They will be built from source for the correct architecture.

# Setting final permissions
function setPermissions {
    # Drop lgpio's notification FIFOs before the ownership reset rather than
    # after. Versions that ran the board service with its working directory
    # inside the install tree left these here as the service user; the reset
    # below would otherwise chown them to root and freeze a runtime artifact
    # into a tree meant to hold only packaged files. The service now works from
    # /run/universalchess, so nothing recreates them.
    find "${DGTCM_PATH}" -maxdepth 1 -name '.lgd-nfy*' -delete 2>/dev/null || true

    # Reset the whole tree to root first. dpkg already unpacks as root, but an
    # upgrade from a version that ran the old blanket `chown -R $PRIMARY_USER`
    # arrives with a service-user-owned tree -- without this reset the escalation
    # would survive precisely on the boards that were already exposed.
    chown -R root:root "${DGTCM_PATH}"

    grantRuntimeDataOwnership

    # Reclaim the TLS material. This must run *after* the config grant above,
    # because that grant is recursive and would otherwise leave the CA and server
    # private keys owned by the service user -- enough to mint certificates the
    # device trusts. Generation and renewal happen in the root-run
    # universal-chess-tls.service, so the service user needs no write access here.
    #
    # Ownership only, no chmod: the web app runs as the service user and reads
    # rootCA.pem to serve the CA download and the iOS mobileconfig profile, so
    # locking the directory to root-only would break those endpoints. The private
    # keys are already 0600 (set by universalchess.tls), so root ownership alone
    # puts them out of the service user's reach.
    if [[ -d "${DGTCM_PATH}/config/ssl" ]]; then
        chown -R root:root "${DGTCM_PATH}/config/ssl"
    fi

    if [[ -d "${CENTAUR}" ]]; then
        chown -R "$PRIMARY_USER:root" ${CENTAUR}
        # Ensure centaur executable has execute permissions (Trixie compatibility)
        if [[ -f "${CENTAUR}centaur" ]]; then
            chmod +x "${CENTAUR}centaur"
        fi
    fi

}


function copyDefaults {
    cp -rn ${DGTCM_PATH}/defaults/* ${DGTCM_PATH}/
}

update_hostname

#Old versions special handling tasks
function cleanOldBeta {
    rm -rf "${PRIMARY_HOME}/DGTCentaurMods"
}


function restoreConfig {
    cp /tmp/config/centaur.ini $CONFIGINI
}


function restoreDatabase {
    cp /tmp/db/centaur.db ${DGTCM_PATH}/db && rm -r /tmp/db
}


function removeLegacyRcLocal {
    if [ -f "$LEGACY_RC_LOCAL" ] && grep -q "$LEGACY_RC_LOCAL_MARKER" "$LEGACY_RC_LOCAL"; then
        echo -e "::: Removing legacy rc.local launcher"
        rm -f "$LEGACY_RC_LOCAL"
    fi
}


case $1 in
    configure* )
        case $2 in
            1.0-beta|1.0.1-beta)
                cleanOldBeta
                ;;
        esac       
    echo -e "::: Finalizing install..."
    
    # Restore migrated database from old package if present (before copyDefaults)
    MIGRATION_DIR="/tmp/dgtcm-migration"
    if [ -f "$MIGRATION_DIR/centaur.db" ]; then
        echo -e "::: Restoring game database from old package migration"
        mkdir -p "${DGTCM_PATH}/db"
        cp -f "$MIGRATION_DIR/centaur.db" "${DGTCM_PATH}/db/" 2>/dev/null || true
    fi
    
    #Copy over all defaults from /defaults
    copyDefaults
    
    # Restore Lichess API token after copyDefaults (so it doesn't get overwritten)
    if [ -f "$MIGRATION_DIR/lichess-token" ]; then
        TOKEN=$(cat "$MIGRATION_DIR/lichess-token")
        if [ -n "$TOKEN" ]; then
            echo -e "::: Restoring Lichess API token from old package migration"
            sed -i "s/^api_token\s*=.*/api_token = $TOKEN/" "${DGTCM_PATH}/config/centaur.ini" 2>/dev/null || true
        fi
    fi
    
    # Clean up migration directory
    rm -rf "$MIGRATION_DIR"

    # Setup nginx proxy for web service
    echo -e "::: Setting up nginx proxy"
    if [ -f "${DGTCM_PATH}/scripts/enable-web-proxy.sh" ]; then
        chmod +x "${DGTCM_PATH}/scripts/enable-web-proxy.sh"
        "${DGTCM_PATH}/scripts/enable-web-proxy.sh"
    else
        echo -e "::: Warning: enable-web-proxy.sh not found"
    fi

    removeLegacyRcLocal

    # Precompile the package to bytecode while still root. The install tree is
    # root-owned, so the service user cannot write __pycache__ at import time the
    # way it could when the tree was user-owned -- without this, every boot
    # re-parses every module from source.
    #
    # .venv is excluded because pip byte-compiles what it installs; recompiling it
    # would walk roughly fourteen times more modules than the application itself
    # and add that to every update, on the hardware where it costs most.
    #
    # `|| true` because bytecode is an optimisation: under `set -e` a single
    # unparseable file would otherwise abort the whole install, turning a
    # startup-speed concern into a failed package.
    echo -e "::: Precompiling Python bytecode"
    "$VENV_DIR/bin/python" -m compileall -q -x '(^|/)\.venv/' "${DGTCM_PATH}" > /dev/null 2>&1 || true

    setPermissions
    
    # Kick the BlueZ advertising self-heal (start --no-block returns immediately;
    # the oneshot runs after this script exits and apt releases its lock). It is
    # a fast no-op when bluez + kernel are unchanged, so this is cheap. On a fresh
    # install the reboot below may interrupt a first-time build; the boot safety
    # net (universal-chess-bluez-selfheal-boot.service, enabled above) re-runs it
    # on the next boot since the marker is still absent/degraded, and the APT hook
    # re-triggers it on the next apt run. Advertising surfaces as ADV_FAILED (and
    # now "self-heal in progress" once the heal restarts) until it completes.
    if command -v systemctl >/dev/null 2>&1; then
        systemctl start --no-block universal-chess-bluez-selfheal.service 2>/dev/null || true
    fi

    if [ -z "${2:-}" ]; then
        # Fresh install: reboot to apply new group memberships and start
        # services cleanly. Set DGTCM_SKIP_REBOOT=1 to suppress.
        if [ -z "${DGTCM_SKIP_REBOOT:-}" ]; then
            echo -e "::: Fresh install -- rebooting to complete setup..."
            # Schedule the reboot from a transient systemd unit owned by PID 1
            # rather than a backgrounded child of this maintainer script. A
            # nohup'd '&' child stays inside apt/dpkg's cgroup (or the invoking
            # SSH session scope); the moment 'apt install ./...deb' returns that
            # scope is torn down and the orphaned child is killed by SIGTERM --
            # which nohup does NOT ignore -- before it can issue the reboot, so
            # the box prints this message but never reboots. systemd-run hands
            # the work to PID 1, which outlives apt. Same lesson already applied
            # in scripts/install-update.
            #
            # The unit first waits for the dpkg locks to clear so the reboot
            # cannot interrupt the tail of the current apt transaction (trigger
            # processing continues after this postinst returns), which could
            # otherwise leave packages half-configured and needing a manual
            # `dpkg --configure -a` before anything else installs.
            #
            # Both locks are watched: apt holds lock-frontend for the whole
            # transaction, but a plain `dpkg -i` takes only /var/lib/dpkg/lock,
            # so the frontend alone reads as free during exactly that install.
            #
            # Every path that cannot confirm the transaction ended declines to
            # reboot rather than rebooting anyway. The earlier version did the
            # opposite -- it polled for 300s and then rebooted regardless, and
            # skipped the wait entirely when fuser was missing -- so the two
            # cases it could not handle were the two that reboot into a live
            # dpkg. Not rebooting is recoverable: the install prints that a
            # reboot is recommended, and the boot-time units re-run on the next
            # one. (psmisc is in Depends so fuser is present; the guard covers
            # the case where it is not, instead of silently not waiting.)
            REBOOT_CMD='
if ! command -v fuser >/dev/null 2>&1; then
    echo "universal-chess: no fuser, cannot tell when dpkg finishes -- skipping automatic reboot" >&2
    exit 0
fi
i=0
while fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock >/dev/null 2>&1; do
    if [ "$i" -ge 360 ]; then
        echo "universal-chess: dpkg still busy after 30 minutes -- skipping automatic reboot" >&2
        exit 0
    fi
    sleep 5
    i=$((i + 1))
done
sleep 2
systemctl reboot
'
            if [ -d /run/systemd/system ] && command -v systemd-run >/dev/null 2>&1; then
                systemd-run --collect --unit=universal-chess-firstboot-reboot \
                    /bin/sh -c "$REBOOT_CMD" >/dev/null 2>&1
            elif command -v systemctl >/dev/null 2>&1; then
                # No systemd-run available: best-effort detached child. It can
                # still be reaped by cgroup teardown, but systemd-run is present
                # on every supported Raspberry Pi OS release.
                nohup /bin/sh -c "$REBOOT_CMD" >/dev/null 2>&1 &
            else
                nohup /bin/sh -c "sleep 5; /sbin/shutdown -r now" >/dev/null 2>&1 &
            fi
        else
            echo -e "::: DGTCM_SKIP_REBOOT set; skipping automatic reboot."
            echo -e "::: A reboot is recommended to apply group and service changes."
        fi
    else
        # Upgrade: reload and restart services without rebooting.
        echo -e "::: Upgrade from $2 -- restarting services..."
        systemctl daemon-reload
        systemctl restart universal-chess.service universal-chess-web.service 2>/dev/null || true
    fi
    ;;
esac


exit 0

