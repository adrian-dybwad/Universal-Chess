#!/bin/bash

set -euo pipefail

# Detect the primary non-root user. On Raspberry Pi OS this is the user
# created during first-boot (historically "pi", but modern installs let
# the user choose any name). We look for UID 1000 first; fall back to
# SUDO_USER if available; last resort is "pi" for compatibility.
detect_primary_user() {
    local uid1000
    uid1000=$(getent passwd 1000 2>/dev/null | cut -d: -f1)
    if [ -n "${uid1000:-}" ]; then
        echo "$uid1000"
        return
    fi
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        echo "$SUDO_USER"
        return
    fi
    echo "pi"
}

PRIMARY_USER=$(detect_primary_user)
PRIMARY_HOME=$(eval echo "~$PRIMARY_USER")

# Raspberry Pi OS ships gpio/kmem; Armbian typically does not. usermod
# exits 6 when the group is absent, which aborts the rest of configure.
add_primary_user_to_group_if_present() {
    local group="$1"
    if getent group "$group" >/dev/null 2>&1; then
        usermod -a -G "$group" "$PRIMARY_USER"
    fi
}

# gpio/spi exist on Raspberry Pi OS; Armbian has neither, and leaves
# /dev/gpiochip* and /dev/spidev* at 600 root:root. Create the groups so
# udev GROUP= can chown those nodes for the service user.
ensure_system_group() {
    local group="$1"
    if ! getent group "$group" >/dev/null 2>&1; then
        groupadd --system "$group"
    fi
}

# Reload udev so gpiochip/spidev pick up GROUP=gpio/spi, then apply the
# same ownership now so this configure does not wait for a reboot.
_apply_epaper_device_permissions() {
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --action=add --subsystem-match=gpio --subsystem-match=spidev || true
    fi
    local node
    if getent group gpio >/dev/null 2>&1; then
        for node in /dev/gpiochip*; do
            [ -e "$node" ] || continue
            chgrp gpio "$node" || true
            chmod 0660 "$node" || true
        done
    fi
    if getent group spi >/dev/null 2>&1; then
        for node in /dev/spidev*; do
            [ -e "$node" ] || continue
            chgrp spi "$node" || true
            chmod 0660 "$node" || true
        done
    fi
}

# Configure needrestart to suppress all blue screen prompts
# This prevents interactive dialogs during package updates/kernel upgrades
if [ -f /etc/needrestart/needrestart.conf ]; then
    # Set restart mode to automatic (no prompts for service restarts)
    if grep -q '^\$nrconf{restart}' /etc/needrestart/needrestart.conf; then
        sed -i "s/^\$nrconf{restart}.*$/\$nrconf{restart} = 'a';/" /etc/needrestart/needrestart.conf
    elif grep -q "^#.*\$nrconf{restart}" /etc/needrestart/needrestart.conf; then
        sed -i "s/^#.*\$nrconf{restart}.*$/\$nrconf{restart} = 'a';/" /etc/needrestart/needrestart.conf
    else
        echo "\$nrconf{restart} = 'a';" >> /etc/needrestart/needrestart.conf
    fi
    
    # Disable kernel upgrade check (prevents "pending kernel upgrade" blue screen)
    if grep -q '^\$nrconf{kernelhints}' /etc/needrestart/needrestart.conf; then
        sed -i "s/^\$nrconf{kernelhints}.*$/\$nrconf{kernelhints} = 0;/" /etc/needrestart/needrestart.conf
    elif grep -q "^#.*\$nrconf{kernelhints}" /etc/needrestart/needrestart.conf; then
        sed -i "s/^#.*\$nrconf{kernelhints}.*$/\$nrconf{kernelhints} = 0;/" /etc/needrestart/needrestart.conf
    else
        echo "\$nrconf{kernelhints} = 0;" >> /etc/needrestart/needrestart.conf
    fi
    
    echo "::: Configured needrestart for automatic mode (no prompts)"
fi

DEFAULT_HOSTNAME="raspberrypi"
ARCH=`uname -m`
NEW_HOSTNAME="dgtcentaur"

# Detect boot partition location (Trixie uses /boot/firmware, Bullseye uses /boot)
if [ -d "/boot/firmware" ] && [ -f "/boot/firmware/config.txt" ]; then
    BOOT_DIR="/boot/firmware"
elif [ -f "/boot/config.txt" ]; then
    BOOT_DIR="/boot"
else
    echo "Warning: Could not detect boot partition location, defaulting to /boot/firmware"
    BOOT_DIR="/boot/firmware"
fi

CONFIG="${BOOT_DIR}/config.txt"
CMDLINEFILE="${BOOT_DIR}/cmdline.txt"

PACKAGE="universalchess"
PACKAGES_PATH="/opt"
DGTCM_PATH="${PACKAGES_PATH}/${PACKAGE}"
DATABASE="${DGTCM_PATH}/db/centaur.db"
CONFIGINI="${DGTCM_PATH}/config/centaur.ini"
BTMAIN="/etc/bluetooth/main.conf"
DBUSSERVICE="/etc/systemd/system/dbus-org.bluez.service"
CENTAUR="${PRIMARY_HOME}/centaur/"
CENTAUR_ENGINE="${PRIMARY_HOME}/centaur/engines"
STOCKFISH="stockfish"
VENV_DIR="$DGTCM_PATH/.venv"
REQ_VENV="$DGTCM_PATH/setup/requirements.txt"
WHEELS_DIR="$DGTCM_PATH/wheels"   # ship this in the .deb (optional but recommended)
LEGACY_RC_LOCAL="/etc/rc.local"
LEGACY_RC_LOCAL_MARKER="Starting DGT Centaur menu"

# Directories the running product creates, updates or deletes files inside, and
# which therefore must be writable by the service user. Everything else under
# ${DGTCM_PATH} stays root-owned.
#
# Why the tree is not simply handed to the service user: scripts/ holds the
# helpers that each have a passwordless sudo grant (install-update, bt-admin,
# uc-set-timezone, centaur-import-mount, uc-engine-deps, uc-build-memory,
# centaur-armhf-setup). Write access to a file root will execute on request is
# equivalent to root, so a compromised web process could rewrite a helper and run
# its own code as root through the existing grant. The Python sources the
# root-run units execute and .venv/ carry the same exposure.
#
# config/ is listed whole because centaur.ini is rewritten via a temp file
# created in that directory, and engine .uci profiles are added and removed
# there. config/ssl is reclaimed by root afterwards (see setPermissions).
RUNTIME_WRITABLE_DIRS=(
    config
    db
    engines
    tmp
    web/static
    pending-updates
)

# Runtime-written files that sit at the install root rather than inside one of the
# directories above, so a directory-only grant would miss them.
RUNTIME_WRITABLE_FILES=(
    update-state.json
)

# Grant the service user exactly the runtime data paths, leaving the rest of the
# install tree root-owned. Safe to call more than once.
function grantRuntimeDataOwnership {
    local relative_path
    for relative_path in "${RUNTIME_WRITABLE_DIRS[@]}"; do
        mkdir -p "${DGTCM_PATH}/${relative_path}"
        chown -R "$PRIMARY_USER:$PRIMARY_USER" "${DGTCM_PATH}/${relative_path}" 2>/dev/null || true
    done
    for relative_path in "${RUNTIME_WRITABLE_FILES[@]}"; do
        # Created here rather than left to first write: the tree-wide root reset
        # would otherwise leave an existing file root-owned and unwritable.
        touch "${DGTCM_PATH}/${relative_path}"
        chown "$PRIMARY_USER:$PRIMARY_USER" "${DGTCM_PATH}/${relative_path}" 2>/dev/null || true
    done
}
################################

# Raspberry Pi OS only. Armbian has no config.txt; `cat` of a missing file
# would abort this script under `set -e` and leave the package unconfigured.
if [ -f "$CONFIG" ] && ! grep -q "#dgtcentaurmods" "$CONFIG"
then
    echo -e "::: Hardware configuration"
    echo -e "::: Backup some first"
    cp $CONFIG $CONFIG.bak
    cp $CMDLINEFILE $CMDLINEFILE.bak

    # Disable SPI0 to avoid GPIO 7 conflict with e-Paper BUSY pin
    echo "::: Checking SPI"
    # SPI0 uses GPIO 7 as CE1, which conflicts with e-Paper BUSY pin
    # e-Paper display uses SPI1 instead (configured below)
    if grep -q '^dtparam=spi=on' "$CONFIG"; then
      sed -i 's/^dtparam=spi=on/#dtparam=spi=on  # Disabled: conflicts with e-Paper BUSY pin (GPIO 7)/' "$CONFIG"
    elif ! grep -q '^#dtparam=spi=on' "$CONFIG" && ! grep -q 'dtparam=spi=off' "$CONFIG"; then
      printf '%s\n' '#dtparam=spi=on  # Disabled: conflicts with e-Paper BUSY pin (GPIO 7)' >> "$CONFIG"
    fi
    
    echo -e "::: Checking SPI 1.0 bus."
    # If you really need /dev/spidev1.x, add an SPI1 overlay (choose CS count)
    if ! grep -q '^dtoverlay=spi1-.*cs' "$CONFIG"; then
      printf '%s\n' 'dtoverlay=spi1-1cs,cs0_spidev=on' >> "$CONFIG"
    elif grep -q '^dtoverlay=spi1-1cs' "$CONFIG" && ! grep -q 'cs0_spidev=on' "$CONFIG"; then
      # upgrade existing line to include spidev binding
      sed -i 's/^dtoverlay=spi1-1cs.*/dtoverlay=spi1-1cs,cs0_spidev=on/' "$CONFIG"
    fi

    # Note: SPI0 is disabled above to avoid GPIO 7 conflict
    # SPI1 is enabled via dtoverlay=spi1-1cs above
    # raspi-config command removed to avoid re-enabling SPI0
  
    # Ensure the user has SPI permissions
    adduser "$PRIMARY_USER" spi || true

    echo "::: Checking serial port. "
    # Enable UART (idempotent)
    if grep -q '^#enable_uart=1' "$CONFIG"; then
      sed -i 's/^#enable_uart=1.*/enable_uart=1/' "$CONFIG"
    elif ! grep -q '^enable_uart=1' "$CONFIG"; then
      printf '%s\n' 'enable_uart=1' >> "$CONFIG"
    fi
    
    # Mark file as modified
    sed -i "$ a #dgtcentaurmods" $CONFIG
fi

# Remove every serial-console token from the cmdline file named by $1.
#
# The Centaur board is wired to the Pi's primary UART, so a kernel console on
# that same port puts a login getty in contention with the board.
#
# Tokens are matched by name. A previous version deleted the first
# whitespace-delimited token instead, which only worked because Raspberry Pi
# Imager happens to write the console first: raspi-config inserts it immediately
# before root= ("s/root=/console=serial0,115200 root=/"), and cloud-init drives
# that path whenever user-data sets rpi.interfaces.serial. On such a card the
# positional delete removed console=tty1 and left the serial console in place --
# the opposite of the intent, silently and with no error.
#
# The two expressions split on position because the token carries a separating
# space only on one side when it starts the line. The baud suffix is optional in
# the kernel's console syntax, hence "anything up to whitespace" rather than a
# required ",[0-9]+". printf replaces an earlier "echo -e", which interpreted
# backslash escapes in kernel arguments. The temporary file keeps a power loss
# mid-write from truncating cmdline.txt and leaving the card unbootable.
strip_serial_console() {
  # serial0 is the udev alias (ttyS0 on a Pi Zero / Zero 2 W); raspi-config
  # writes ttyAMA0 when the board exposes no serial0 alias.
  _consoles='serial0|ttyS0|ttyAMA0'
  _cmdline_file="$1"
  _original=$(cat "$_cmdline_file") || return 1
  _stripped=$(printf '%s\n' "$_original" | sed -E \
    -e "s/[[:space:]]+console=($_consoles)[^[:space:]]*//g" \
    -e "s/^console=($_consoles)[^[:space:]]*[[:space:]]*//") || return 1
  if [ "$_stripped" = "$_original" ]; then
    return 0
  fi
  echo "::: Disabling serial console (UART is reserved for the Centaur board)"
  printf '%s\n' "$_stripped" > "${_cmdline_file}.uc-tmp" || return 1
  mv "${_cmdline_file}.uc-tmp" "$_cmdline_file"
}

configure_armbian_uart() {
  # Free the header UART on Armbian. The Centaur MCU shares ttyS0 with the
  # kernel console. This image's boot.cmd treats console=display like both
  # (still injects console=ttyS0,115200), so the working setting is
  # console=none plus extraargs=console=tty1. Does not enable SPI overlays:
  # stock sun50i-h616 spidev nodes are not the Centaur e-paper pins.
  #
  # Writes via a temp file rather than sed -i so the helper is testable on
  # macOS (BSD sed -i requires a backup suffix) and a power loss mid-write
  # cannot leave a truncated env file.
  _env_file="$1"
  [ -f "$_env_file" ] || return 0
  _original=$(cat "$_env_file") || return 1
  _updated=$(printf '%s\n' "$_original" | awk '
    BEGIN { seen_console=0; seen_extra=0 }
    /^console=/ {
      print "console=none"
      seen_console=1
      next
    }
    /^extraargs=/ {
      line=$0
      if (line !~ /console=tty1/) {
        line=line " console=tty1"
      }
      print line
      seen_extra=1
      next
    }
    { print }
    END {
      if (!seen_console) print "console=none"
      if (!seen_extra) print "extraargs=console=tty1"
    }
  ') || return 1
  if [ "$_updated" = "$_original" ]; then
    return 0
  fi
  printf '%s\n' "$_updated" > "${_env_file}.uc-tmp" || return 1
  mv "${_env_file}.uc-tmp" "$_env_file"
}



configure_armbian_spi_gpio() {
  # Load the spi-gpio overlay that matches this Orange Pi family.
  # H616/H618 Zero 2W uses PI-bank pads; H3/H5 40-pin boards use PD/PA/PG.
  # Boards without a 40-pin Centaur map get no overlay. Does not enable
  # sun50i-h616 spidev0_0 / spidev1_0 (onboard NOR / Pi SPI0 header).
  #
  # Args: armbianEnv.txt or orangepiEnv.txt, overlay .dts path, model string.
  _env_file="$1"
  _dts="$2"
  _model="$3"
  _overlay=""
  _m=$(printf '%s' "$_model" | tr '[:upper:]' '[:lower:]')
  case "$_m" in
    *orange*pi*zero*2*w*|*orangepi*zero*2*w*|*orangepi*zero2w*)
      _overlay=uc-centaur-spi-gpio ;;
  esac
  if [ -z "$_overlay" ]; then
    if echo "$_m" | grep -qE 'one[[:space:]]*plus|lite[[:space:]]*2'; then
      :
    elif echo "$_m" | grep -qE 'orange[[:space:]]*pi[[:space:]]*(pc([[:space:]]|$|-)|pc[[:space:]]*plus|pc[[:space:]]*2|one([[:space:]]|$|-)|lite([[:space:]]|$|-)|plus([[:space:]]|$|-)|plus[[:space:]]*2|plus2e|prime([[:space:]]|$|-)|2([[:space:]]|$))'; then
      _overlay=uc-centaur-spi-gpio-h3
    elif echo "$_m" | grep -qE 'orangepi[[:space:]]*(pc|one|lite|plus|plus2e|plus2|prime|2)([[:space:]]|$|-)'; then
      _overlay=uc-centaur-spi-gpio-h3
    fi
  fi
  [ -n "$_overlay" ] || return 0
  _dir=$(dirname "$_dts")
  _use="${_dir}/${_overlay}.dts"
  [ -f "$_use" ] || _use="$_dts"
  [ -f "$_env_file" ] || return 0
  [ -f "$_use" ] || return 0
  _original=$(cat "$_env_file") || return 1
  _uart3=""
  if [ "$_overlay" = "uc-centaur-spi-gpio-h3" ]; then
    _uart3=uart3
  fi
  _updated=$(printf '%s\n' "$_original" | awk -v name="$_overlay" -v uart3="$_uart3" '
    BEGIN { seen=0; seen_ov=0 }
    /^user_overlays=/ {
      if ($0 ~ name) { print; seen=1; next }
      print $0 " " name
      seen=1
      next
    }
    /^overlays=/ {
      if (uart3 != "" && $0 !~ "(^|[[:space:]])" uart3 "([[:space:]]|$)") {
        print $0 " " uart3
      } else print
      seen_ov=1
      next
    }
    { print }
    END {
      if (!seen) print "user_overlays=" name
      if (uart3 != "" && !seen_ov) print "overlays=" uart3
    }
  ') || return 1
  if [ "$_updated" != "$_original" ]; then
    printf '%s\n' "$_updated" > "${_env_file}.uc-tmp" || return 1
    mv "${_env_file}.uc-tmp" "$_env_file"
  fi
  if command -v armbian-add-overlay >/dev/null 2>&1; then
    armbian-add-overlay "$_use" >/dev/null 2>&1 || true
  fi
}

if [ -f "$CMDLINEFILE" ]; then
    strip_serial_console "$CMDLINEFILE"
fi

_uc_model=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || true)
_uc_dts="${DGTCM_PATH}/board/overlays/uc-centaur-spi-gpio.dts"
_uc_configured_uart=0
for _uc_env in /boot/armbianEnv.txt /boot/orangepiEnv.txt; do
    [ -f "$_uc_env" ] || continue
    echo "::: Configuring UART (header UART reserved for the Centaur board) via $_uc_env"
    configure_armbian_uart "$_uc_env"
    echo "::: Configuring spi-gpio (Centaur e-paper on Pi SPI1 header pins) via $_uc_env"
    configure_armbian_spi_gpio "$_uc_env" "$_uc_dts" "$_uc_model"
    _uc_configured_uart=1
done
if [ "$_uc_configured_uart" -eq 1 ]; then
    systemctl disable --now serial-getty@ttyS0.service 2>/dev/null || true
    systemctl disable --now serial-getty@ttyS3.service 2>/dev/null || true
fi

    # Setting up Bluetooth configuration
    echo -e "::: Setting up Bluetooth configuration"

    # Unblock Bluetooth hardware
    sudo rfkill unblock bluetooth || true

    # Install Bluetooth configuration files
    sudo mkdir -p /etc/bluetooth
    sudo mkdir -p /etc/systemd/system/bluetooth.service.d

    # Copy pin.conf if it doesn't exist
    if [ ! -f /etc/bluetooth/pin.conf ]; then
        echo "* *" | sudo tee /etc/bluetooth/pin.conf > /dev/null
    fi

    # No PRETTY_HOSTNAME is written: the board sets the adapter Alias at runtime
    # (Adapter1.Alias, e.g. "MILLENNIUM CHESS"), which is what remote clients see.
    # Leaving /etc/machine-info unset lets the read-only BlueZ Name fall back to
    # the system hostname instead of a hardcoded faked Revelation-II serial.

    # Install systemd service overrides (but NOT rfcomm.service)
    sudo mkdir -p /etc/systemd/system/bluetooth.service.d
    sudo mkdir -p /etc/systemd/system/bthelper@.service.d
    sudo cp ${DGTCM_PATH}/../etc/systemd/system/bluetooth.service.d/*.conf /etc/systemd/system/bluetooth.service.d/ 2>/dev/null || true
    sudo cp ${DGTCM_PATH}/../etc/systemd/system/var-run-sdp.* /etc/systemd/system/ 2>/dev/null || true
    sudo cp ${DGTCM_PATH}/../etc/systemd/system/bthelper@.service.d/*.conf /etc/systemd/system/bthelper@.service.d/ 2>/dev/null || true

    # Set correct permissions
    sudo chmod 644 /etc/bluetooth/pin.conf

    echo -e "::: Enabling Bluetooth services"
    systemctl daemon-reload
    systemctl enable bluetooth.service || true
    systemctl enable var-run-sdp.path || true

    # Start Bluetooth
    systemctl start bluetooth || true


# Make DGTCM available to all users (idempotent)
DISTPKG_DIR="/usr/lib/python3/dist-packages"
TARGET_PATH="${DISTPKG_DIR}/DGTCentaurMods"
install -d "$DISTPKG_DIR"
# Replace any existing file/dir/symlink with a symlink to $DGTCM_PATH
rm -rf "$TARGET_PATH"
ln -sfnT "$DGTCM_PATH" "$TARGET_PATH"

# Allow flask on port 80
# sudo touch /etc/authbind/byport/80
# sudo chmod 777 /etc/authbind/byport/80

# Allow memory access for epaper driver. gpio/spi are created when missing
# (Armbian) so udev can grant gpiochip/spidev; kmem stays Pi-only.
ensure_system_group gpio
ensure_system_group spi
add_primary_user_to_group_if_present gpio
add_primary_user_to_group_if_present spi
add_primary_user_to_group_if_present kmem
_apply_epaper_device_permissions

# Allow Bluetooth service advertising (required for advertise_service)
add_primary_user_to_group_if_present bluetooth

# Allow reading Bluetooth HID keyboard events from /dev/input/event* (the
# devices BlueZ creates for a paired keyboard are owned root:input). The
# service runs as the primary user, so it must be in the 'input' group.
add_primary_user_to_group_if_present input


##### Patch systemd services and tmpfiles to use the detected primary user.
echo -e "::: Configuring services for user: $PRIMARY_USER"
    sed -i "s/^User=pi$/User=$PRIMARY_USER/" /etc/systemd/system/universal-chess.service 2>/dev/null || true
    sed -i "s/^User=pi$/User=$PRIMARY_USER/" /etc/systemd/system/universal-chess-web.service 2>/dev/null || true
    if [ -f /usr/lib/tmpfiles.d/universal-chess.conf ]; then
        sed -i "s/ pi pi / $PRIMARY_USER $PRIMARY_USER /" /usr/lib/tmpfiles.d/universal-chess.conf
    fi

##### Enable systemd services.
echo -e "::: Setup services"
    systemctl daemon-reload

    echo -e "::: Disabling rfcomm.service (application manages RFCOMM in Python)"
    systemctl disable rfcomm.service 2>/dev/null || true

    echo -e "::: Stopping rfcomm.service"
    systemctl stop rfcomm.service 2>/dev/null || true

    echo -e "::: Enabling universal-chess-web.service"
    systemctl enable universal-chess-web.service

    echo -e "::: Enabling universal-chess.service"
    systemctl enable universal-chess.service
    # universal-chess-stop-controller.service - fallback shutdown hook that sleeps
    # the controller when the main service is not running to do it itself.
    #
    # Releases up to 2.0.0 shipped it as WantedBy=shutdown.target, which reboot,
    # kexec and soft-reboot also reach -- so the hook would sleep the controller
    # mid-reboot and the controller, being the board's power manager, would cut
    # power instead of letting the Pi come back. It is now wanted by the
    # power-off targets alone. systemctl enable never removes symlinks an older
    # [Install] section created, so the stale one is dropped explicitly first or
    # upgraded boards would keep powering off on reboot.
    rm -f /etc/systemd/system/shutdown.target.wants/universal-chess-stop-controller.service
    systemctl enable universal-chess-stop-controller.service

    # Boot-time BlueZ self-heal safety net. The apply/retire heal is normally
    # install/apt-triggered, but a reboot can interrupt a first-time on-board
    # build (notably the fresh-install reboot at the end of this script), leaving
    # stock BlueZ broken with nothing to re-trigger it. Enabling this unit re-runs
    # the heal on the next boot ONLY when the last decision is missing or degraded
    # (it is a true no-op on a healthy board). See scripts/bluez-selfheal.
    echo -e "::: Enabling BlueZ self-heal boot safety net"
    systemctl enable universal-chess-bluez-selfheal-boot.service 2>/dev/null || true

    # Clear any pending-update marker BEFORE starting services. This install
    # is that pending update, so the freshly started web/board services must
    # not load a stale "update pending" from update-state.json. Doing it here
    # (rather than only in the updater's install script, which runs after this
    # postinst completes) closes a race where the restarted web service caches
    # the stale pending value in memory.
    STATE_FILE="${DGTCM_PATH}/update-state.json"
    if [ -f "$STATE_FILE" ]; then
        echo -e "::: Clearing pending update state"
        python3 - "$STATE_FILE" <<'PYEOF' || true
import json, sys, pathlib
p = pathlib.Path(sys.argv[1])
try:
    s = json.loads(p.read_text())
    s["pending_deb"] = None
    s["available_version"] = None
    s["available_release_tag"] = None
    p.write_text(json.dumps(s, indent=2))
except Exception:
    pass
PYEOF
    fi

    echo -e "::: Starting services"
    systemctl start universal-chess-web.service || true
    systemctl start universal-chess.service || true

#    systemctl enable ntp
    systemctl enable var-run-sdp.path
    systemctl enable var-run-sdp.service
    systemctl start var-run-sdp.path

    # Hostname-matching TLS certificate. The oneshot regenerates the cert (with
    # SANs for the current <hostname>.local) at boot before nginx; the path unit
    # retriggers it immediately whenever /etc/hostname changes (device rename),
    # so the cert never drifts from the name clients use to reach the device.
    echo -e "::: Enabling hostname-matching TLS certificate units"
    systemctl enable universal-chess-tls.path 2>/dev/null || true
    systemctl enable universal-chess-tls.service 2>/dev/null || true
    systemctl start universal-chess-tls.path 2>/dev/null || true

# Allow the web service user to change passwords via chpasswd (used by
# the /api/system/change-password endpoint). The sudoers drop-in grants
# passwordless access to chpasswd only.
echo -e "::: Configuring sudoers for password change"
SUDOERS_FILE="/etc/sudoers.d/universal-chess-chpasswd"
echo "$PRIMARY_USER ALL=(root) NOPASSWD: /usr/sbin/chpasswd" > "$SUDOERS_FILE"
chmod 440 "$SUDOERS_FILE"

# Allow the service user to self-update. The install needs root (apt +
# systemd-run), but granting NOPASSWD on apt/systemd-run is equivalent to
# unrestricted root. Instead, grant passwordless access to exactly one pinned
# helper, which validates the .deb (must live in the managed pending-updates
# directory) before installing. See scripts/install-update for details.
echo -e "::: Configuring sudoers for self-update"
INSTALL_HELPER="${DGTCM_PATH}/scripts/install-update"
if [ -f "$INSTALL_HELPER" ]; then
    chmod +x "$INSTALL_HELPER"
    UPDATE_SUDOERS_FILE="/etc/sudoers.d/universal-chess-update"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $INSTALL_HELPER" > "$UPDATE_SUDOERS_FILE"
    chmod 440 "$UPDATE_SUDOERS_FILE"
else
    echo -e "::: Warning: install-update helper not found at $INSTALL_HELPER"
fi

# Allow the service user to configure the Bluetooth controller for LE
# advertising and toggle the radio. The board's BLE bring-up runs btmgmt
# (bondable off / le on / connectable on) and the board/web run rfkill, all of
# which need root. Granting passwordless sudo on btmgmt/rfkill directly would
# let the user reconfigure any controller or block any radio, and the btmgmt
# calls are wrapped in `timeout` (so the sudo command is `timeout`, not
# `btmgmt`, making an argument-vector sudoers match brittle). Instead, as with
# the updater, grant passwordless sudo to exactly one pinned helper that
# performs only those operations and refuses anything else. Without this grant
# the controller is never configured and phone chess apps cannot discover the
# board over BLE (the symptom this fixes).
echo -e "::: Configuring sudoers for Bluetooth admin"
BT_ADMIN_HELPER="${DGTCM_PATH}/scripts/bt-admin"
if [ -f "$BT_ADMIN_HELPER" ]; then
    chmod +x "$BT_ADMIN_HELPER"
    BT_SUDOERS_FILE="/etc/sudoers.d/universal-chess-bluetooth"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $BT_ADMIN_HELPER" > "$BT_SUDOERS_FILE"
    chmod 440 "$BT_SUDOERS_FILE"
    # Validate the drop-in before it can take effect; a malformed sudoers file
    # can lock out sudo, so remove it rather than leave it broken.
    if ! visudo -cf "$BT_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: bt-admin sudoers entry invalid; removing"
        rm -f "$BT_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: bt-admin helper not found at $BT_ADMIN_HELPER"
fi

# Allow the service user to operate Wi-Fi. Every Wi-Fi action needs root: the scan
# (iwlist), the connection profiles (nmcli add/up/delete) and the radio toggle
# (rfkill). None of them was granted, so on a board without a blanket NOPASSWD
# rule the network list was always empty, connect and forget did nothing and the
# radio switch had no effect -- and because the callers did not check the exit
# status, all of it was reported to the user as success. Granting nmcli outright
# would be control over every connection on the machine, so -- as with bt-admin --
# grant exactly one pinned helper, whose `case` is the boundary: it performs only
# these operations, validates the SSID and UUID it is given, and takes the
# passphrase on stdin so it never reaches a command line.
echo -e "::: Configuring sudoers for WiFi admin"
WIFI_ADMIN_HELPER="${DGTCM_PATH}/scripts/uc-wifi-admin"
if [ -f "$WIFI_ADMIN_HELPER" ]; then
    chmod +x "$WIFI_ADMIN_HELPER"
    WIFI_SUDOERS_FILE="/etc/sudoers.d/universal-chess-wifi"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $WIFI_ADMIN_HELPER" > "$WIFI_SUDOERS_FILE"
    chmod 440 "$WIFI_SUDOERS_FILE"
    # Validate the drop-in before it can take effect; a malformed sudoers file
    # can lock out sudo, so remove it rather than leave it broken.
    if ! visudo -cf "$WIFI_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: uc-wifi-admin sudoers entry invalid; removing"
        rm -f "$WIFI_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: uc-wifi-admin helper not found at $WIFI_ADMIN_HELPER"
fi

# Allow the service user to expand swap for the duration of an engine source
# build. A compile of a modern engine (notably one embedding an NNUE net) can
# exceed a 512MB board's RAM and be OOM-killed; uc-build-memory brings up a zram
# tier + a temporary SD-card swap backstop for the build and tears it down after,
# so normal play runs on RAM alone. The helper needs root (modprobe/zramctl/
# mkswap/swapon/sysctl), so -- as with bt-admin and the updater -- grant
# passwordless sudo to exactly this one pinned helper, whose `case` is the
# boundary (it performs only acquire/release/status and validates its PID arg).
# The BlueZ self-heal calls the same helper directly (it already runs as root).
echo -e "::: Configuring sudoers for build memory"
BUILD_MEM_HELPER="${DGTCM_PATH}/scripts/uc-build-memory"
if [ -f "$BUILD_MEM_HELPER" ]; then
    chmod +x "$BUILD_MEM_HELPER"
    BUILD_MEM_SUDOERS_FILE="/etc/sudoers.d/universal-chess-build-memory"
    echo "$PRIMARY_USER ALL=(root) NOPASSWD: $BUILD_MEM_HELPER" > "$BUILD_MEM_SUDOERS_FILE"
    chmod 440 "$BUILD_MEM_SUDOERS_FILE"
    # Validate before it can take effect; a malformed drop-in can lock out sudo.
    if ! visudo -cf "$BUILD_MEM_SUDOERS_FILE" >/dev/null 2>&1; then
        echo -e "::: Warning: build-memory sudoers entry invalid; removing"
        rm -f "$BUILD_MEM_SUDOERS_FILE"
    fi
else
    echo -e "::: Warning: build-memory helper not found at $BUILD_MEM_HELPER"
fi

# Persistent runtime swap. Distinct from the build-scoped uc-build-memory helper:
# a two-engine game with analysis loads up to three engine subprocesses at once
# (player 1 + player 2, each dedicated, plus the shared analysis engine), and a
# transient fourth during an engine switch. On a ~415MB board whose only swap is
# the stock ~415MB zram (compressed RAM, which competes for the same RAM and so
# adds no real capacity under starvation) that working set OOM-kills an engine and
# moves silently stop. universal-chess-swap.service runs uc-runtime-swap at boot to
# provision a real disk-backed swapfile (sized to a 4GB total RAM+swap budget, 0 on
# boards that already meet it), and 99-universalchess-swap.conf sets vm.swappiness
# low so the card is only touched under genuine pressure. The helper runs as root
# via the unit, so it needs no sudoers grant.
echo -e "::: Configuring persistent runtime swap"
RUNTIME_SWAP_HELPER="${DGTCM_PATH}/scripts/uc-runtime-swap"
if [ -f "$RUNTIME_SWAP_HELPER" ]; then
    chmod +x "$RUNTIME_SWAP_HELPER"
    systemctl daemon-reload
    systemctl enable universal-chess-swap.service 2>/dev/null || true
    # Apply the low-swappiness policy now (an upgrade does not reboot; a fresh
    # install reboots below, where systemd-sysctl re-applies it from the drop-in).
    if [ -f /etc/sysctl.d/99-universalchess-swap.conf ]; then
        sysctl -p /etc/sysctl.d/99-universalchess-swap.conf >/dev/null 2>&1 || true
    fi
    # Provision the swapfile now so this install gets headroom without waiting for
    # a reboot. Idempotent: a re-run re-activates the existing file rather than
    # rewriting the card. Best-effort -- a failure here must not break the install.
    systemctl start universal-chess-swap.service 2>/dev/null || true
else
    echo -e "::: Warning: runtime-swap helper not found at $RUNTIME_SWAP_HELPER"
fi

# Allow the service user to set the device OS timezone from the web/board
# Settings. `timedatectl set-timezone` is root-only, so -- as with bt-admin and
# the updater -- grant passwordless sudo to exactly one pinned helper. The
# helper validates its single argument (shape + zoneinfo membership) before
# calling timedatectl, so the grant cannot become an arbitrary-string or
# arbitrary-command primitive. Without it the timezone selector saves the choice
# but cannot apply it to the clock.
echo -e "::: Configuring sudoers for timezone"
SET_TZ_HELPER="${DGTCM_PATH}/scripts/uc-set-timezone"
