# HTTPS server -- full application (port 443)
# Cert paths are generated by mkcert and stored under
# /opt/universalchess/config/ssl/. The filenames are hostname-independent
# (server.pem / server-key.pem) so this config never changes when the device
# is renamed -- universal-chess-tls.service regenerates the cert's SANs for the
# current hostname before nginx starts (and on /etc/hostname changes). If the
# files don't exist yet (pre-TLS install), nginx refuses to start; the install
# generates them before enabling this config.
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /opt/universalchess/config/ssl/server.pem;
    ssl_certificate_key /opt/universalchess/config/ssl/server-key.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Centaur SD-image import: a large (hundreds of MB), slow request. The body is
    # the uploaded image, and the response is only sent after the server
    # decompresses + loop-mounts + copies the app on the board. The default 1m
    # body cap (413s the upload before it reaches the app) and 60s proxy timeout
    # are both too small here, so this exact path gets a large body limit and a
    # long read/send timeout. Scoped to this location so other endpoints keep the
    # tighter defaults.
    location = /api/system/import-centaur {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 2g;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# HTTP server -- CA install page only (port 80)
# Serves the certificate download and install instructions so clients
# can bootstrap trust before they can access HTTPS. All other paths
# are redirected to HTTPS.
server {
    listen 80;
    server_name _;

    # Root over HTTP serves the CA install page (not the app, whose JS/CSS
    # bundle is HTTPS-only and would 301 to HTTPS and fail -- producing a
    # blank screen). Clients land here to bootstrap trust before HTTPS.
    location = / {
        proxy_pass http://127.0.0.1:5000/ca-install;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /ca-install {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /ca.pem {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else: redirect to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}
