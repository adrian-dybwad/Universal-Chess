[Unit]
Description=Universal Chess
# Deliberately NOT After=network.target. The board drives the e-paper panel over
# SPI, the chess board over serial and GPIO; it needs no IP to show the splash
# screen or find the board. network.target is only reached once NetworkManager
# reports active, which on a Pi Zero takes ~50 s -- it runs `netplan generate`
# four times at ~11.5 s each, re-serializing every connection profile, including
# ones for interfaces the board does not have. That put the splash screen 65 s
# later than it needed to be. The web unit keeps its network ordering, since
# there is nobody to serve until the network exists.
After=bluetooth.target
Wants=bluetooth.target

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=DGTCM_PATH=/opt
Environment=PYTHONPATH=/opt
ExecStartPre=/bin/sleep 4
ExecStart=/opt/universalchess/.venv/bin/python -m universalchess.main
# Not the install tree: that is root-owned so the service user cannot rewrite the
# sudo-granted helpers in scripts/, and lgpio creates its .lgd-nfy notification
# FIFO in the working directory the moment RPi.GPIO is imported. /run/universalchess
# is created for the service user by tmpfiles.d and emptied on every boot, so no
# stale FIFO survives. Deliberately not RuntimeDirectory=, which systemd would
# delete on every stop, taking the IPC sockets the web process needs with it.
WorkingDirectory=/run/universalchess
# append:, not file:. systemd opens a file: target at offset zero without
# truncating, so a restarting service overwrites the head of its own log while
# older content survives underneath -- a current mtime over a stale tail.
StandardOutput=append:/var/log/modmenuoutput.log
StandardError=append:/var/log/modmenuoutput.log
Restart=on-failure
RestartSec=3
User=pi

[Install]
WantedBy=multi-user.target
