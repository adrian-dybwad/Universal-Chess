[Unit]
Description=Universal Chess Web interface
After=network.target universal-chess.service

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt
Environment=FLASK_APP=app.py
Environment=FLASK_RUN_HOST=0.0.0.0
Environment=FLASK_RUN_PORT=5000
ExecStart=/opt/universalchess/.venv/bin/python -m flask run --host=0.0.0.0 --port=5000
WorkingDirectory=/opt/universalchess/web
# append:, not file:. See universal-chess.service for why: a file: target is
# opened at offset zero and not truncated, so restarts interleave new output
# with stale content instead of replacing it.
StandardOutput=append:/var/log/universal-chess-web.log
StandardError=append:/var/log/universal-chess-web.log
Restart=always
User=pi

[Install]
WantedBy=multi-user.target


