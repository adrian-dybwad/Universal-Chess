      "visibleWhen": { "store": "update", "key": "has_download", "equals": true },
      "platforms": ["board"]
    },
    {
      "id": "updates.install_local",
      "key": "InstallLocal",
      "type": "action",
      "action": "install_local",
      "label": "Install\nLocal .deb",
