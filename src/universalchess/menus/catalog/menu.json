      "icon": { "true": "checkbox_checked", "false": "checkbox_empty" },
      "platforms": ["board"]
    },
    {
      "id": "updates.channel",
      "key": "Channel",
      "type": "select",
      "label": "Channel",
      "boardLabel": "Channel\n{value}",
      "help": "Stable releases are recommended. Nightly builds may contain bugs.",
