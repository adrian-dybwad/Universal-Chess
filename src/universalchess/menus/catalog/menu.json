      "bind": { "store": "update", "key": "channel" },
      "icon": "settings",
      "selectedIcon": "checkbox_checked",
      "unselectedIcon": "checkbox_empty",
      "platforms": ["board"]
    },
    {
      "id": "updates.check",
      "key": "CheckNow",
