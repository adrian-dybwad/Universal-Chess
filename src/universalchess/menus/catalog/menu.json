      "action": "start_game",
      "label": "Start\nGame",
      "icon": "play",
      "help": "Start a game with the current player configuration.",
      "platforms": ["board"],
      "epaper": { "font_size": 12, "height_ratio": 0.8 }
    },
    {
      "id": "settings.player_detail",
