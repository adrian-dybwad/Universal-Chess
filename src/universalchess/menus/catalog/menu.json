{
  "version": 1,
  "description": "Shared menu catalog. Single source of truth for menu structure, labels, icons, help tips, e-paper styles, and web field metadata. The e-paper board and the React web UI each render this through their own renderer; inherently dynamic menus (device scans, engine/player lists) stay code-driven but read their chrome (label/icon/help) from here.",
  "roots": ["main", "settings", "connectivity", "system", "power"],

  "sections": [
    { "id": "players", "label": "Players", "icon": "players" },
    { "id": "game", "label": "Game", "icon": "timer_checked" },
    { "id": "display", "label": "Display", "icon": "display" },
    { "id": "sound", "label": "Sound", "icon": "sound" },
    { "id": "accounts", "label": "Accounts", "icon": "account" },
    { "id": "engines", "label": "Engines", "icon": "engine" },
    { "id": "system", "label": "System", "icon": "system" }
  ],

  "optionSets": {
    "color": [
      { "value": "white", "label": "White", "icon": "white_piece" },
      { "value": "black", "label": "Black", "icon": "black_piece" }
    ],
    "player_type": [
      { "value": "human", "label": "Human", "icon": "universal_logo" },
      { "value": "engine", "label": "Engine", "icon": "engine" },
      { "value": "hand_brain", "label": "Hand + Brain", "icon": "engine" },
      { "value": "lichess", "label": "Lichess", "icon": "lichess" }
    ],
    "hand_brain_mode": [
      { "value": "normal", "label": "Normal (Engine = Brain)" },
      { "value": "reverse", "label": "Reverse (Human = Brain)" }
    ],
    "time_control": [
      { "value": "0", "label": "Untimed" },
      { "value": "1", "label": "1 min (Bullet)" },
      { "value": "3", "label": "3 min (Blitz)" },
      { "value": "5", "label": "5 min (Blitz)" },
      { "value": "10", "label": "10 min (Rapid)" },
      { "value": "15", "label": "15 min (Rapid)" },
      { "value": "30", "label": "30 min (Classical)" },
      { "value": "60", "label": "60 min (Classical)" },
      { "value": "90", "label": "90 min (Classical)" }
    ],
    "update_channel": [
      { "value": "stable", "label": "Stable (Recommended)" },
      { "value": "nightly", "label": "Nightly (Development)" }
    ],
    "sleep_timer": [
      { "value": "0", "label": "Disabled" },
      { "value": "300", "label": "5 min" },
      { "value": "600", "label": "10 min" },
      { "value": "900", "label": "15 min" },
      { "value": "1800", "label": "30 min" },
      { "value": "3600", "label": "1 hour" }
    ]
  },

  "nodes": [
    {
      "id": "main",
      "type": "menu",
      "label": "Main Menu",
      "platforms": ["board"],
      "children": ["main.play", "main.settings", "main.centaur"]
    },
    {
      "id": "main.play",
      "key": "Universal",
      "type": "action",
      "label": "PLAY",
      "label_in_progress": "RESUME",
      "icon": "universal_logo",
      "help": "Start a new game. When a game is suspended this reads RESUME and continues it.",
      "platforms": ["board"],
      "epaper": { "height_ratio": 2.0, "icon_size": 80, "layout": "vertical", "font_size": 32, "bold": true }
    },
    {
      "id": "main.settings",
      "key": "Settings",
      "type": "submenu",
      "label": "Settings",
      "icon": "settings",
      "help": "Configure players, time control, positions, display, connectivity, and system options.",
      "target": "settings",
      "platforms": ["board"],
      "epaper": { "height_ratio": 1.0, "layout": "horizontal", "font_size": 16 }
    },
    {
      "id": "main.centaur",
      "key": "Centaur",
      "type": "action",
      "label": "Original\nCentaur",
      "icon": "centaur",
      "help": "Switch back to the original DGT Centaur software.",
      "platforms": ["board", "web"],
      "epaper": { "height_ratio": 0.67, "icon_size": 28, "layout": "horizontal", "font_size": 14 }
    },

    {
      "id": "settings",
      "type": "menu",
      "label": "Settings",
      "children": ["settings.players", "settings.timecontrol", "settings.display", "settings.sound", "settings.positions", "settings.connectivity", "settings.system"]
    },
    {
      "id": "settings.players",
      "key": "Players",
      "type": "submenu",
      "target": "settings.players",
      "label": "Players",
      "icon": "players",
      "help": "Configure player names, types, and engine preferences.",
      "section": "players",
      "epaper": { "font_size": 12, "height_ratio": 0.8 },
      "children": ["players.player1", "players.player2", "players.start"]
    },
    {
      "id": "players.player1",
      "type": "action",
      "action": "open_player1",
      "label": "Player 1\n{fn:player1_summary}",
