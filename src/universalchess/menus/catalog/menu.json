      "bind": { "store": "game", "key": "time_control" },
      "optionSet": "time_control",
      "selectedIcon": "timer_checked",
      "unselectedIcon": "timer",
      "epaper": { "font_size": 12, "height_ratio": 0.8 }
    },
    {
      "id": "settings.positions",
      "key": "Positions",
