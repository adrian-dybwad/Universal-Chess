      "epaper": { "font_size": 12, "height_ratio": 0.8 },
      "children": [
        "settings.display.board",
        "field.display.show_clock",
        "field.display.show_analysis",
        "field.display.show_graph",
        "field.display.led_brightness"
      ]
    },
    {
      "id": "settings.display.board",
      "key": "board",
      "type": "submenu",
      "target": "settings.display.board",
      "label": "Board",
      "icon": "display",
      "help": "Board visibility and the sprite sheet used to draw pieces.",
      "platforms": ["board"],
      "epaper": { "font_size": 14, "height_ratio": 0.8 },
      "children": ["field.display.show_board", "field.display.sprites"]
    },
    {
      "id": "settings.sound",
      "key": "Sound",
      "type": "submenu",
      "target": "settings.sound",
      "label": "Sound",
      "icon": "sound",
      "help": "Control audio feedback and beeps.",
      "section": "sound",
      "epaper": { "font_size": 12, "height_ratio": 0.8 },
      "children": [
        "field.sound.enabled",
        "field.sound.piece_events",
        "field.sound.game_events",
        "field.sound.errors",
        "field.sound.key_press"
      ]
