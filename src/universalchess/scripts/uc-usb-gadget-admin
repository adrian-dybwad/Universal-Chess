#!/bin/bash
# uc-usb-gadget-admin -- USB Ethernet gadget mode the service cannot change unprivileged.
#
# WHY THIS EXISTS
#   The web/board Settings can set USB gadget mode to off, auto, client, or
#   shared. Boot/overlay enable goes through Raspberry Pi's ``rpi-usb-gadget``,
#   which is root-only. Current packages only accept on|off|toggle|status|help --
#   there is no ``shared`` verb -- and ``on`` brings the Shared NM profile up with
#   the ICS auto-switcher enabled. UC's Client/Shared preference must therefore
#   pin the matching NetworkManager profile and disable that watcher after
#   ``on -f``; ``auto`` restores that vendor arrangement so the watcher chooses.
#   The service runs unprivileged, so -- as with uc-clock-admin -- passwordless
#   sudo is granted to exactly this one pinned helper (see package postinst):
#     <service-user> ALL=(root) NOPASSWD: /opt/universalchess/scripts/uc-usb-gadget-admin
#
# SECURITY BOUNDARY
#   The `case` below is the boundary for the grant -- it accepts one verb and
#   refuses everything else. Do not add a passthrough or escape branch. Each
#   verb is a fixed argv list, never through a shell, so the grant cannot become
#   an arbitrary-command primitive.
#
#   Callers use `sudo -n` so a missing grant fails fast ("a password is
#   required") and is logged, rather than hanging on a password prompt.
#
#   File edits are delegated to uc-usb-gadget-files.py beside this script, so
#   that code can be linted and tested (it decides whether the board still
#   boots). It is resolved next to this file and run by absolute path: anything
#   able to modify it could already modify this granted helper, so it carries no
#   privilege this script does not already have.
#
# SYMMETRY
#   Every change the on-modes make outside ``rpi-usb-gadget`` is undone by
#   ``off``: the kernel command line's gadget modules, and the stock
#   netplan-eth0 profile that had to be moved aside. A mode setting that quietly
#   keeps boot-time edits after the user turns the feature off is a setting the
#   user cannot actually turn off.
#
# TEST SEAMS
#   UC_USB_GADGET_ADMIN_DRY_RUN=1   print the intended invocation to
#                                  $UC_USB_GADGET_ADMIN_ACTION_LOG instead of running it
#   UC_USB_GADGET_ADMIN_ACTION_LOG  file to append dry-run actions to
#   UC_USB_GADGET_FS_ROOT           prefix for every path read or written, so the
#                                  real file edits can be exercised against a
#                                  temp tree instead of /boot and /etc
#   None of these can reach here through the sudo grant: sudo's env_reset drops
#   the environment, and none of them is in an env_keep list.
set -u

DRY_RUN="${UC_USB_GADGET_ADMIN_DRY_RUN:-0}"
ACTION_LOG="${UC_USB_GADGET_ADMIN_ACTION_LOG:-}"
FS_ROOT="${UC_USB_GADGET_FS_ROOT:-}"
# Overridable so tests (and a chroot) can point at a fake model file.
DEVICE_TREE_MODEL="${UC_DEVICE_TREE_MODEL:-/proc/device-tree/model}"
LOG_TAG="uc-usb-gadget-admin"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FILES_TOOL="${SCRIPT_DIR}/uc-usb-gadget-files.py"

CLIENT_CONN="USB Gadget (client)"
SHARED_CONN="USB Gadget (shared)"
# Stock Pi netplan names this eth0 DHCP-client profile; empty match claims usb0.
NETPLAN_ETH0_CONN="netplan-eth0"
ICS_UNIT="rpi-usb-gadget-ics.service"
CMDLINE_FW="${FS_ROOT}/boot/firmware/cmdline.txt"
CMDLINE_LEGACY="${FS_ROOT}/boot/cmdline.txt"
NETPLAN_DIR="${FS_ROOT}/etc/netplan"
NM_STATE_DIR="${FS_ROOT}/var/lib/NetworkManager"
SHARED_LEASE_FILE="${NM_STATE_DIR}/dnsmasq-usb0.leases"
ETH0_SYSFS="${FS_ROOT}/sys/class/net/eth0"

log() { logger -t "$LOG_TAG" -- "$*" 2>/dev/null || true; echo "[$LOG_TAG] $*" >&2; }

usage() {
    echo "usage: uc-usb-gadget-admin {off|auto|client|shared|read-shared-leases|gadget-stack}" >&2
    exit 2
}

record() {
    if [ -n "$ACTION_LOG" ]; then echo "$*" >> "$ACTION_LOG"; fi
}

run_priv() {
    if [ "$DRY_RUN" = "1" ]; then
        record "$*"
        return 0
    fi
    "$@"
}

# File edits run for real whenever a seam root is set, so the tests drive the
# same code the board runs. Without one, a dry run touches no file at all.
files_enabled() {
    [ "$DRY_RUN" != "1" ] || [ -n "$FS_ROOT" ]
}

cmdline_path() {
    if [ -f "$CMDLINE_FW" ]; then
        echo "$CMDLINE_FW"
    elif [ -f "$CMDLINE_LEGACY" ]; then
        echo "$CMDLINE_LEGACY"
    fi
}

# Bind dwc2 and g_ether from the kernel cmdline so the gadget is armed before
# userspace starts and a host plugged in at boot enumerates on its first try.
# Vendor ``on`` only writes modules-load.d, which binds later. Takes effect on
# the next reboot.
#
# A failure here does not fail the mode: the mode itself applied, and the only
# loss is the early bind (a host already attached at boot may need one replug).
# It is logged as an error rather than passed over, because the alternative --
# reporting success for a boot edit that did not happen -- is how a board ends up
# behaving differently from what the log says was done to it.
edit_cmdline() {
    local action="$1" marker="$2" cmdline
    record "$marker"
    files_enabled || return 0
    cmdline="$(cmdline_path)"
    if [ -z "$cmdline" ]; then
        log "no cmdline.txt at ${CMDLINE_FW} or ${CMDLINE_LEGACY}; skipping $action"
        return 0
    fi
    if ! python3 "$FILES_TOOL" "$action" "$cmdline"; then
        log "ERROR: $action on $cmdline failed; boot-time gadget binding unchanged"
        return 1
    fi
    return 0
}

# Stock images ship netplan-eth0 with match:{} (any ethernet). On boards with no
# eth0 (Pi Zero / this DGT image: only usb0+wlan0) that profile claims usb0 as a
# DHCP *client* and fights Shared (Pi DHCP *server*). Move it aside when eth0 is
# absent; when eth0 exists, restrict the match to that name only. Either way a
# backup is kept beside it so ``off`` can put the board back.
#
# Do not run ``netplan apply`` here -- it can hang and disrupt wlan0. nmcli
# delete + removing the NM-owned yaml is enough.
#
# Moving it aside also removes what made usb0 managed at all: NetworkManager
# ships a udev rule marking every gadget interface unmanaged. The package's
# 90-uc-usb-gadget-managed.conf drop-in is what keeps usb0 managed from then on.
pin_netplan_eth0_off_usb0() {
    record "pin-netplan-eth0-off-usb0"
    if [ -e "$ETH0_SYSFS" ]; then
        # Real ethernet port: keep the profile but never let it match usb0.
        run_priv nmcli connection modify "$NETPLAN_ETH0_CONN" \
            match.interface-name eth0 \
            connection.interface-name eth0 || true
        detach_netplan_eth0 --eth0-present
        run_priv nmcli connection reload || true
    else
        run_priv nmcli connection delete "$NETPLAN_ETH0_CONN" || true
        detach_netplan_eth0 --eth0-absent
    fi
    run_priv nmcli connection down "$NETPLAN_ETH0_CONN" || true
}

detach_netplan_eth0() {
    files_enabled || return 0
    if ! python3 "$FILES_TOOL" detach-netplan-eth0 "$NETPLAN_DIR" "$1"; then
        log "ERROR: could not detach $NETPLAN_ETH0_CONN from usb0 in $NETPLAN_DIR"
        return 1
    fi
    return 0
}

# Restoring the yaml is enough: netplan regenerates the NetworkManager profile
# from it at boot, and turning the gadget off already asks for a reboot to finish
# (usb0 and the loaded modules outlive the setting change). Nothing is brought up
# here -- that would mean claiming an interface the user just turned off.
restore_netplan_eth0() {
    record "restore-netplan-eth0"
    files_enabled || return 0
    if ! python3 "$FILES_TOOL" restore-netplan-eth0 "$NETPLAN_DIR"; then
        log "ERROR: could not restore $NETPLAN_ETH0_CONN in $NETPLAN_DIR"
        return 1
    fi
    return 0
}

# Releases up to 2.0.0 widened this directory to world-traversable so the
# unprivileged service could read the Shared dnsmasq lease file for status. That
# made NetworkManager's state readable by every local user to save one privileged
# read, which the ``read-shared-leases`` verb now does instead. Boards that took
# the widening get it undone here, on any mode change.
ensure_nm_state_dir_private() {
    record "ensure-nm-state-dir-private"
    if [ "$DRY_RUN" = "1" ]; then return 0; fi
    if [ -d "$NM_STATE_DIR" ]; then
        chmod o-rwx "$NM_STATE_DIR" || log "note: could not tighten $NM_STATE_DIR"
    fi
}

# Vendor ``on`` leaves Shared autoconnecting and the ICS watcher flipping
# client<->shared. Pin the requested profile so the preference survives reboot
# and is not undone when the host is not offering ICS.
pin_client() {
    # ICS disable is best-effort (unit may be absent on older images).
    run_priv systemctl disable --now "$ICS_UNIT" || true
    edit_cmdline arm-cmdline ensure-early-g-ether-cmdline || true
    pin_netplan_eth0_off_usb0
    ensure_nm_state_dir_private
    run_priv nmcli connection modify "$CLIENT_CONN" connection.autoconnect yes || return 1
    run_priv nmcli connection modify "$SHARED_CONN" connection.autoconnect no || return 1
    # down/up are best-effort: first enable often needs a reboot before usb0 exists.
    run_priv nmcli connection down "$SHARED_CONN" || true
    run_priv nmcli connection up "$CLIENT_CONN" || true
    return 0
}

pin_shared() {
    run_priv systemctl disable --now "$ICS_UNIT" || true
    edit_cmdline arm-cmdline ensure-early-g-ether-cmdline || true
    pin_netplan_eth0_off_usb0
    ensure_nm_state_dir_private
    run_priv nmcli connection modify "$SHARED_CONN" connection.autoconnect yes || return 1
    run_priv nmcli connection modify "$CLIENT_CONN" connection.autoconnect no || return 1
    run_priv nmcli connection down "$CLIENT_CONN" || true
    run_priv nmcli connection up "$SHARED_CONN" || true
    return 0
}

# Auto is the vendor arrangement: the ICS unit watches what the host offers and
# moves the link between Client and Shared. Restore the autoconnect a fresh
# ``on -f`` leaves (Shared yes, Client no) so the watcher is not working against
# a profile the pinned modes left pinned, and move nothing itself -- choosing a
# profile here would both race the unit and drop a live USB session.
enable_auto_switching() {
    run_priv systemctl enable --now "$ICS_UNIT" || true
    edit_cmdline arm-cmdline ensure-early-g-ether-cmdline || true
    pin_netplan_eth0_off_usb0
    ensure_nm_state_dir_private
    run_priv nmcli connection modify "$SHARED_CONN" connection.autoconnect yes || return 1
    run_priv nmcli connection modify "$CLIENT_CONN" connection.autoconnect no || return 1
    return 0
}

# Off is the user withdrawing consent for the whole feature, so it also undoes
# the boot-time and NetworkManager changes the on-modes made. The vendor tool
# removes its own overlay and modules-load.d entry; the rest is ours to clean up.
disable_gadget() {
    edit_cmdline disarm-cmdline disarm-early-g-ether-cmdline || true
    restore_netplan_eth0 || true
    ensure_nm_state_dir_private
    return 0
}

# Privileged read of the Shared-mode dnsmasq lease file. NetworkManager's state
# directory is 0700 root, and a lease is the only signal that a host on the gadget
# link took an address rather than sitting on a self-assigned one.
#
# No lease file is success with no output: Shared has simply never served one, and
# zero is the true count. A file that exists but cannot be read is a failure, so
# the caller reports "unknown" -- printing nothing there would claim an empty pool
# nobody observed, which is the exact confusion this count exists to clear up.
read_shared_leases() {
    if [ ! -f "$SHARED_LEASE_FILE" ]; then
        exit 0
    fi
    if ! cat -- "$SHARED_LEASE_FILE"; then
        log "ERROR: could not read $SHARED_LEASE_FILE"
        exit 1
    fi
    exit 0
}

is_orangepi_zero2w() {
    # Keep in step with board/profile: the _ORANGEPI and _H616_40 pair that
    # routes a model to _orangepi_h616(). Missing model file
    # (CI hosts, Pi boards) is not an Orange Pi -- the Pi rpi-usb-gadget
    # path stays the default so existing tests and shipping images are unchanged.
    local model
    [ -r "$DEVICE_TREE_MODEL" ] || return 1
    model=$(tr -d '\0' < "$DEVICE_TREE_MODEL" 2>/dev/null) || return 1
    echo "$model" | grep -qiE '^orange[[:space:]]*pi[[:space:]]+zero[[:space:]]*2[[:space:]]*w'
}

gadget_stack() {
    if is_orangepi_zero2w; then
        echo sunxi-musb
    else
        echo rpi-dwc2
    fi
}

enable_sunxi_gadget() {
    # musb UDC is already peripheral; persist g_ether and give usb0 DHCP.
    record "arm-modules-load"
    record "ensure-usb0-dhcp-netplan"
    if files_enabled; then
        mkdir -p "${FS_ROOT}/etc/modules-load.d" "${FS_ROOT}/etc/netplan"
        if ! python3 "$FILES_TOOL" arm-modules-load \
            "${FS_ROOT}/etc/modules-load.d/usb-gadget.conf"; then
            log "ERROR: could not persist g_ether in modules-load.d"
            return 1
        fi
        if ! python3 "$FILES_TOOL" ensure-usb0-dhcp-netplan \
            "${FS_ROOT}/etc/netplan/60-uc-usb-gadget.yaml"; then
            log "ERROR: could not write usb0 DHCP netplan"
            return 1
        fi
    fi
    run_priv modprobe g_ether
    return 0
}

disable_sunxi_gadget() {
    record "disarm-modules-load"
    record "remove-usb0-dhcp-netplan"
    if files_enabled; then
        python3 "$FILES_TOOL" disarm-modules-load \
            "${FS_ROOT}/etc/modules-load.d/usb-gadget.conf" || true
        python3 "$FILES_TOOL" remove-usb0-dhcp-netplan \
            "${FS_ROOT}/etc/netplan/60-uc-usb-gadget.yaml" || true
    fi
    run_priv modprobe -r g_ether || true
    return 0
}

run_mode() {
    local mode="$1"
    if is_orangepi_zero2w; then
        case "$mode" in
            client)
                if enable_sunxi_gadget; then
                    log "USB gadget set to client (g_ether on musb UDC)"
                    exit 0
                fi
                ;;
            off)
                if disable_sunxi_gadget; then
                    log "USB gadget set to off"
                    exit 0
                fi
                ;;
            auto|shared)
                log "ERROR: USB gadget $mode is not supported on Orange Pi Zero 2W (needs rpi-usb-gadget ICS / NetworkManager); client uses g_ether on the musb UDC"
                exit 1
                ;;
            *)
                log "ERROR: rejected mode (expected off|auto|client|shared): $mode"
                exit 2
                ;;
        esac
        log "ERROR: applying USB gadget mode $mode failed"
        exit 1
    fi
    case "$mode" in
        off)
            if run_priv rpi-usb-gadget off && disable_gadget; then
                log "USB gadget set to off"
                exit 0
            fi
            ;;
        auto)
            if run_priv rpi-usb-gadget on -f && enable_auto_switching; then
                log "USB gadget set to auto (on -f + ICS auto-switcher enabled)"
                exit 0
            fi
            ;;
        client)
            # -f skips the interactive "unsupported device?" prompt; without it
            # the tool blocks on a closed stdin under the service.
            if run_priv rpi-usb-gadget on -f && pin_client; then
                log "USB gadget set to client (on -f + pinned client profile)"
                exit 0
            fi
            ;;
        shared)
            # No ``rpi-usb-gadget shared`` on current packages; enable the stack
            # then pin the Shared NM profile (and disable ICS auto-switch).
            if run_priv rpi-usb-gadget on -f && pin_shared; then
                log "USB gadget set to shared (on -f + pinned shared profile)"
                exit 0
            fi
            ;;
        *)
            log "ERROR: rejected mode (expected off|auto|client|shared): $mode"
            exit 2
            ;;
    esac
    log "ERROR: applying USB gadget mode $mode failed"
    exit 1
}

main() {
    [ "$#" -eq 1 ] || usage
    case "$1" in
        off|auto|client|shared) run_mode "$1" ;;
        read-shared-leases)     read_shared_leases ;;
        gadget-stack)           gadget_stack ;;
        *)                      usage ;;
    esac
}

main "$@"
