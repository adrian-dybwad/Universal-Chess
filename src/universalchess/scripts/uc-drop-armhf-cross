#!/bin/sh
# Remove the armhf cross toolchain from boards that cannot use it.
#
# The package used to declare:
#
#   Recommends: gcc-arm-linux-gnueabihf, libc6-dev-armhf-cross
#
# and apt installs Recommends by default. Those two exist for one purpose: on a
# 64-bit (arm64) host the native compiler cannot emit Centaur's 32-bit armhf ABI,
# so the display "translate" shim is cross-compiled. On 32-bit ARM they are never
# used -- centaur-armhf-setup exits immediately unless the host is arm64, and the
# shim is built there by the native gcc.
#
# On an ARMv6 board (Pi Zero W, Pi 1) they are actively destructive.
# libc6-dev-armhf-cross installs ARMv7-A startup objects under
# /usr/arm-linux-gnueabihf/lib, and gcc searches that directory ahead of the
# native /usr/lib/arm-linux-gnueabihf. Every locally linked binary therefore gets
# an ARMv7 crt1.o and dies with SIGSEGV in the startup code, before main, on the
# ARMv6 CPU. Measured on a Pi Zero W: `int main(void){return 0;}` exits 139 with
# the default link and 0 with -B/usr/lib/arm-linux-gnueabihf/. The visible
# symptom is that every engine built from source segfaults at startup while its
# binary sits on disk looking installed.
#
# Dropping the Recommends fixes new installs but not the boards already carrying
# the package, so this runs from universal-chess-armhf-cleanup.service to heal
# them on update. Idempotent: once the packages are gone every later boot is two
# dpkg-query calls and an exit.
#
# Runs as root from the unit, so it needs no sudoers grant. It takes no arguments
# and the package set is hard-coded -- do not add a package argument, or a boot
# unit becomes a general "remove anything" primitive.
set -u

# This one package, and only ever this one. It is the only member of the pair
# that is both unusable and harmful off arm64: it owns the ARMv7 startup objects
# under /usr/arm-linux-gnueabihf/lib described above.
#
# gcc-arm-linux-gnueabihf is deliberately NOT here. The name reads as a cross
# compiler, but on an armhf host arm-linux-gnueabihf is the *native* triplet and
# Raspberry Pi OS ships `gcc` with
# `Depends: gcc-arm-linux-gnueabihf (= 4:14.2.0-1+rpi1)`. An earlier version of
# this script purged it and took gcc, g++, build-essential and universal-chess
# off a board with them -- the cleanup removed the application it shipped with.
# On arm64 it is a genuine cross compiler and the arch gate below keeps it, so
# there is no host on which this script should remove it.
CROSS_PACKAGES="libc6-dev-armhf-cross"

log() { echo "uc-drop-armhf-cross: $*"; }

# Same gate centaur-armhf-setup uses, so the script that installs this package
# and the script that removes it cannot disagree about who needs it. Anything
# that is not arm64 -- including an unreadable architecture -- is a host whose
# native compiler already targets 32-bit ARM and needs no cross libc.
host_arch="$(dpkg --print-architecture 2>/dev/null || echo unknown)"
if [ "$host_arch" = "arm64" ]; then
	log "host arch arm64 cross-builds the Centaur shim with it; keeping it"
	exit 0
fi

pkg_installed() {
	dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

present=""
for p in $CROSS_PACKAGES; do
	if pkg_installed "$p"; then
		present="$present $p"
	fi
done

if [ -z "$present" ]; then
	log "no armhf cross development packages installed; nothing to do"
	exit 0
fi

log "removing armhf cross development packages:$present"

# No terminal here; a confirmation prompt would hang the unit until its timeout.
export DEBIAN_FRONTEND=noninteractive

# The postinst starts this unit while its own dpkg transaction still holds the
# lock -- that is why the cleanup is a unit and not an inline postinst step,
# which would deadlock. So the purge has to outlast that transaction to land on
# the same update that ships it instead of waiting for the next boot.
#
# apt does this wait itself. An earlier version polled `fuser` on the frontend
# lock for a bounded 120s and then purged regardless, which failed on the first
# board it ran on: the installing transaction on a Pi Zero W was still holding
# the lock three minutes in, so apt exited with "Could not get lock
# /var/lib/dpkg/lock-frontend. It is held by process (apt-get)" and the board
# kept its ARMv7 crt. DPkg::Lock::Timeout also closes the gap between seeing a
# free lock and acquiring it, which polling cannot. Bounded rather than
# infinite, so a genuinely stuck transaction fails this unit instead of pinning
# it forever; the unit stays enabled and retries on the next boot.
#
# Keep universal-chess-armhf-cleanup.service's TimeoutStartSec above this, or
# systemd kills the helper mid-wait -- or worse, mid-purge.
LOCK_WAIT_SECONDS=900

# Ask apt what the purge would do, and abort if the answer names anything this
# script did not. Reasoning about which package is a "cross" package is exactly
# what failed here once: the name looked like a cross toolchain and was the
# native compiler, and the resulting cascade removed the application. Only apt
# knows the real dependency graph of the image it is running on, so the plan is
# checked rather than predicted -- which keeps a future error in the list above
# from being fatal instead of merely wrong.
#
# A plan that cannot be obtained is not an all-clear. apt fails to plan on the
# boards where purging is most dangerous -- a half-finished transaction, a
# broken dependency state -- so every unreadable answer stops the removal.
#
# `apt-get -s` takes no locks, so this runs before the lock wait below.
# shellcheck disable=SC2086 - $present is a subset of the fixed list above
if ! plan="$(apt-get -s purge $present 2>/dev/null)"; then
	log "refusing to purge:$present -- apt could not produce a removal plan"
	exit 1
fi

removals="$(printf '%s\n' "$plan" | sed -nE 's/^(Purg|Remv) ([^ :]+).*/\2/p')"
if [ -z "$removals" ]; then
	log "refusing to purge:$present -- apt reported no removals for it"
	exit 1
fi

for pkg in $removals; do
	case " $CROSS_PACKAGES " in
		*" $pkg "*) ;;
		*)
			log "refusing to purge:$present -- apt would also remove $pkg"
			exit 1
			;;
	esac
done

# Purge only what is actually installed: naming an absent package makes some apt
# versions exit non-zero, which would report a healed board as a unit failure.
# Deliberately no --auto-remove -- this fixes one specific packaging mistake and
# must not garbage-collect build dependencies a user installed by hand.
# shellcheck disable=SC2086 - $present is a subset of the fixed list above
if ! apt-get purge -y -o DPkg::Lock::Timeout="$LOCK_WAIT_SECONDS" $present; then
	log "removal failed; this board's native toolchain may still be broken"
	exit 1
fi

log "removed:$present"
exit 0
