#!/bin/sh
# Root helper that provisions everything a 64-bit (arm64) host needs to run the
# imported Centaur binary under Universal Chess. Centaur is a 32-bit armhf ELF,
# so on arm64 it needs:
#   - the armhf runtime  (libc6:armhf) so the binary can execute at all, and
#   - the armhf cross toolchain (gcc-arm-linux-gnueabihf + libc6-dev-armhf-cross)
#     so the display "translate" shim (spishim.so) can be built for centaur's
#     armhf ABI on this aarch64 host.
#
# Invoked by the Centaur SD import through a single pinned, passwordless sudo
# grant the package postinst installs:
#
#   <service-user> ALL=(root) NOPASSWD: /opt/universalchess/scripts/centaur-armhf-setup
#
# Why a fixed helper instead of NOPASSWD on apt/dpkg directly: apt-get install is
# a general primitive (any package) and granting it would be equivalent to
# unrestricted root. This helper narrows the grant to exactly: enable the armhf
# foreign architecture (only when the armhf runtime is missing) and install the
# fixed package set below -- nothing the caller can influence. The hard-coded
# architecture + package list are the security boundary; do NOT add a package
# argument or a passthrough branch.
#
# This is done here, at import time, rather than as package Depends because
# libc6:armhf is not installable until `dpkg --add-architecture armhf` has been
# run and the armhf index fetched -- a system reconfiguration apt cannot perform
# while resolving its own dependencies. Import time is also when the apt lock is
# free (no dpkg transaction in flight) and the network is typically up.
#
# Callers use `sudo -n` so a missing grant fails fast rather than hanging on a
# password prompt. Idempotent (installs only what is missing) and a no-op on a
# native 32-bit ARM host.
set -u

# Fixed package set. libc6:armhf pulls the loader plus the core C library the
# binary and shim need at run time; gcc-arm-linux-gnueabihf + libc6-dev-armhf-cross
# are the cross toolchain the shim build invokes on this host. Only libc6:armhf is
# a foreign-arch (armhf) package; the two cross packages are native (arm64) and
# need no foreign architecture. Additional armhf libraries Centaur may need surface
# later as a clear "cannot open shared object" and can be appended here.
ARMHF_RUNTIME_PKG="libc6:armhf"
REQUIRED_PACKAGES="$ARMHF_RUNTIME_PKG gcc-arm-linux-gnueabihf libc6-dev-armhf-cross"

log() { echo "centaur-armhf: $*"; }

# True when the named package (which may carry an :arch qualifier) is fully
# installed. Used to install only what is missing, so an already-provisioned
# board is a fast no-op and -- crucially -- a board that already has the runtime
# still gets the toolchain (a loader-presence check alone would wrongly skip it).
pkg_installed() {
	dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

# Only 64-bit (arm64) hosts need any of this. On a native armhf host the runtime
# is already present and the native gcc builds the shim, so this is a clean no-op.
host_arch="$(dpkg --print-architecture 2>/dev/null || echo unknown)"
if [ "$host_arch" != "arm64" ]; then
	log "host arch '$host_arch' needs no armhf provisioning; nothing to do"
	exit 0
fi

missing=""
for p in $REQUIRED_PACKAGES; do
	pkg_installed "$p" || missing="$missing $p"
done
if [ -z "$missing" ]; then
	log "armhf runtime and shim toolchain already present; nothing to do"
	exit 0
fi
log "missing armhf packages:$missing"

# sudoers env_reset strips caller env, so set the frontend here to keep apt fully
# non-interactive under the grant.
export DEBIAN_FRONTEND=noninteractive

# Wait (bounded) for any in-flight dpkg/apt transaction to release the frontend
# lock, so this cannot collide with a concurrent package operation.
i=0
while command -v fuser >/dev/null 2>&1 && \
      fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 && \
      [ "$i" -lt 60 ]; do
	sleep 2
	i=$((i + 1))
done

# Enable the armhf foreign architecture only when the runtime itself is missing;
# the cross packages are arm64 and do not require it.
case " $missing " in
	*" $ARMHF_RUNTIME_PKG "*)
		if ! dpkg --print-foreign-architectures 2>/dev/null | grep -qx armhf; then
			log "enabling armhf foreign architecture"
			dpkg --add-architecture armhf || { log "add-architecture failed"; exit 1; }
		fi
		;;
esac

log "updating package lists"
apt-get update || log "apt-get update failed (continuing; a cached index may suffice)"

log "installing:$missing"
# shellcheck disable=SC2086 - $missing is a fixed subset of the literal set above
apt-get install -y --no-install-recommends $missing || { log "install failed"; exit 1; }

# Verify every required package is now installed; a partial provision would let a
# later shim build or launch fail with a less obvious error.
for p in $REQUIRED_PACKAGES; do
	pkg_installed "$p" || { log "install reported success but $p is still missing"; exit 1; }
done

log "armhf runtime and shim toolchain installed"
exit 0
