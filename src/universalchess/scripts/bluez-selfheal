#!/bin/bash
# bluez-selfheal -- keep BLE advertising working across OS/kernel updates by
# substituting a minimally-patched bluetoothd ONLY when the stock one is broken,
# and retiring that substitution automatically once the distribution ships the
# fix. Runs at package install/upgrade (scheduled AFTER apt releases its lock),
# never as part of normal boot. See docs/bluetooth/bluez-self-heal.md.
#
# THE PROBLEM
#   Kernel 6.18 (commit d3f7d17960ed) added length validation for the
#   "Add Extended Advertising Data" MGMT command. Released BlueZ 5.82 builds that
#   command with the WRONG struct size (sizeof(struct mgmt_cp_add_advertising),
#   11 bytes, instead of sizeof(struct mgmt_cp_add_ext_adv_data), 3 bytes), so it
#   sends 8 trailing zero bytes. The new kernel rejects it (Invalid Parameters,
#   0x0d) and the board becomes undiscoverable to phone chess apps. The one-line
#   fix exists upstream (BlueZ 2a6968b4) but is not in any released version.
#
# THE STRATEGY (functional, not version-sniffing)
#   Version strings differ across distros and the fix may be backported, so we do
#   NOT match versions. We ask the only question that matters -- "does registering
#   a BLE advert succeed on THIS kernel + bluetoothd?" -- via bluez-advertising-probe:
#     1. With the stock bluetoothd in place, probe.
#     2. PASS  -> the OS is fine (or already carries the fix); retire any prior
#                 diversion and record stack=stock.  <-- AUTO-RETIRE
#     3. FAIL  -> build a patched bluetoothd from THIS OS's OWN bluez source
#                 (maximum ABI compatibility -- never a foreign prebuilt binary),
#                 dpkg-divert the stock one aside, install the patched one,
#                 re-probe; PASS -> record stack=patched, FAIL -> roll back to
#                 stock and record stack=stock (degraded; the failure surfaces
#                 separately as ADV_FAILED in the UI).
#
# WHY NOT EVERY BOOT (mostly)
#   A dpkg-divert + binary persist on disk across reboots, so re-applying per boot
#   is wasted work. The apply/retire heal therefore runs on the inputs that matter:
#   our package install/upgrade and any apt run that could touch bluez or the
#   kernel. The ONE exception is the `boot` mode (universal-chess-bluez-selfheal-
#   boot.service): a reboot can interrupt a first-time on-board build (notably the
#   fresh-install reboot in our postinst), and since the heal is install/apt-driven
#   nothing would otherwise re-trigger it. `boot` closes that gap but stays cheap:
#   it runs the heal ONLY when the last decision is missing or degraded
#   (healthy != True), so a confirmed-healthy board does nothing at boot. It is
#   also a FAST no-op when the bluez version and kernel are unchanged.
set -u

PKG_NAME="bluez"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PROBE="${SCRIPT_DIR}/bluez-advertising-probe"

STATE_DIR="/var/lib/universalchess"
MARKER="${STATE_DIR}/bluez-patch.json"
PROGRESS="${STATE_DIR}/bluez-selfheal.progress"
CACHE_DIR="${STATE_DIR}/bluez"
LOCK="${STATE_DIR}/bluez-selfheal.lock"
LOG_TAG="bluez-selfheal"

# Identify the fix so the UI/marker can show provenance.
FIX_REF="bluez 2a6968b4: advertising: use sizeof(*cp) for Add Ext Adv Data"
FIX_REASON="kernel 6.18 ext-adv-data length validation rejects stock BlueZ 5.82"

# Logs go to stderr (and syslog). Critical: several functions "return" a value
# by echoing it to stdout (e.g. build_patched echoes the binary path), so log
# output must never land on stdout or it pollutes those captured values.
log() { logger -t "$LOG_TAG" -- "$*" 2>/dev/null || true; echo "[$LOG_TAG] $*" >&2; }

# Persistent app event log (services.event_log). The self-heal is the one
# install-class operation that runs as root from a bash unit, not the Python
# app, so it emits its own completion event. event_log.py is intentionally
# stdlib-only, so it is invoked BY FILE PATH (not `python -m`): the package's
# services/__init__ pulls in third-party deps that the system python3 the
# self-heal runs under does not have, whereas the file-path form imports no
# package at all. HEAL_START is set when a real heal begins (past the fast no-op
# skip) so skipped boots emit nothing; consumed by the EXIT trap below.
EVENT_LOG_PY="$(dirname "$SCRIPT_DIR")/services/event_log.py"
HEAL_START=""

emit_heal_event() {
    # emit_heal_event <message> <level>. Best-effort: a missing logger must never
    # fail the heal it is reporting on. Includes elapsed seconds (as ms) when a
    # heal actually started.
    local msg="$1" level="${2:-info}"
    local dur_args=()
    if [ -n "${HEAL_START:-}" ]; then
        dur_args=(--duration-ms "$(( ( $(date +%s) - HEAL_START ) * 1000 ))")
    fi
    [ -f "$EVENT_LOG_PY" ] || return 0
    python3 "$EVENT_LOG_PY" \
        --category bluez_selfheal --level "$level" "${dur_args[@]}" -- "$msg" 2>/dev/null || true
}

# EXIT trap: always clear the transient progress record, and -- only when a real
# heal ran -- log one timed event reflecting the final marker the run just wrote.
# Reading the marker (not the exit path) keeps this DRY across main()'s several
# terminal exits.
on_exit() {
    local rc=$?
    clear_progress
    if [ -n "${HEAL_START:-}" ]; then
        if [ "$rc" -eq 0 ]; then
            if [ "$(marker_field active)" = "patched" ]; then
                emit_heal_event "Self-heal complete: patched bluetoothd, advertising restored" info
            else
                emit_heal_event "Self-heal complete: stock bluetoothd healthy, no patch needed" info
            fi
        else
            emit_heal_event "Self-heal failed: advertising could not be repaired (left stock in place)" error
        fi
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# Environment discovery
# ---------------------------------------------------------------------------

# Heuristic RAM budget (MB) per parallel compile job. An LTO-free C compile of
# bluetoothd still wants well over 100MB resident per job; sizing the divisor at
# 1GB keeps the peak working set within RAM on small boards so the compile stays
# CPU/IO-bound instead of thrashing swap. Overridable for tuning/tests.
BUILD_JOB_MB="${UC_BUILD_JOB_MB:-1024}"

# Compile parallelism bounded by BOTH core count and RAM. `make -j$(nproc)` (=4
# on a quad-core Pi Zero 2 W) with only ~415MB RAM oversubscribes memory and,
# together with the distro's default -flto=auto, makes the board thrash swap for
# tens of minutes on the bluetoothd rebuild (observed: load ~13, kswapd pegged).
# Bounding by RAM/BUILD_JOB_MB floors that to a job count RAM can actually hold.
#
# The override name (UC_BUILD_PARALLELISM) is shared with the Python engine
# builder (managers/engine_manager._build_parallelism) so both source-build paths
# read one knob. Test seams: UC_BLUEZ_MEMTOTAL_MB overrides detected RAM,
# UC_BUILD_NPROC overrides the detected core count, so the maths is pinnable
# without a specific host.
build_jobs() {
    local override cores mem_mb by_mem
    override="${UC_BUILD_PARALLELISM:-}"
    case "$override" in
        ''|*[!0-9]*) : ;;                       # unset/non-numeric -> ignore
        *) if [ "$override" -ge 1 ]; then echo "$override"; return; fi ;;
    esac
    cores="${UC_BUILD_NPROC:-$(nproc 2>/dev/null || echo 1)}"
    case "$cores" in ''|*[!0-9]*) cores=1 ;; esac
    [ "$cores" -ge 1 ] || cores=1
    mem_mb="${UC_BLUEZ_MEMTOTAL_MB:-$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo 2>/dev/null)}"
    # RAM unreadable (e.g. non-Linux): fall back to the core count, prior behaviour.
    case "$mem_mb" in ''|*[!0-9]*) echo "$cores"; return ;; esac
    by_mem=$(( mem_mb / BUILD_JOB_MB ))
    [ "$by_mem" -lt 1 ] && by_mem=1
    if [ "$by_mem" -lt "$cores" ]; then echo "$by_mem"; else echo "$cores"; fi
}

# Resolve the bluetoothd path from the running unit, falling back to the two
# common locations so this works regardless of how the distro lays it out.
detect_bluetoothd() {
    local path
    path="$(systemctl show -p ExecStart --value bluetooth 2>/dev/null \
        | sed -n 's/.*path=\([^ ;]*bluetoothd\).*/\1/p' | head -n1)"
    if [ -n "$path" ] && [ -e "$path" ]; then echo "$path"; return; fi
    for c in /usr/libexec/bluetooth/bluetoothd /usr/lib/bluetooth/bluetoothd; do
        [ -e "$c" ] && { echo "$c"; return; }
    done
    echo "/usr/libexec/bluetooth/bluetoothd"
}

bluez_version() { dpkg-query -W -f='${Version}' "$PKG_NAME" 2>/dev/null || echo "unknown"; }
arch()          { dpkg --print-architecture 2>/dev/null || uname -m; }
kernel_release(){ uname -r; }

# Kernel-populated Bluetooth class directory. Must stay in step with
# board/wireless_capability.SYSFS_BLUETOOTH, which answers the same question for
# the menus, the web payload and the board's startup (a test asserts both carry
# this literal). Overridable so the gate below is testable without a controller.
SYSFS_BLUETOOTH="${UC_SYSFS_BLUETOOTH:-/sys/class/bluetooth}"

has_bluetooth_adapter() {
    # 0 when the kernel has registered at least one Bluetooth controller.
    #
    # This is a HARDWARE question, not a "is it switched on" question: the class
    # entry is created by the kernel driver independently of bluetoothd, and an
    # rfkill-blocked adapter still appears. A board with no controller (a plain
    # Raspberry Pi Zero -- no "W", no wireless die) has an empty directory, so the
    # glob stays unexpanded and the -e test fails.
    local hci
    for hci in "$SYSFS_BLUETOOTH"/hci*; do
        [ -e "$hci" ] && return 0
    done
    return 1
}

# ---------------------------------------------------------------------------
# Marker (the source of truth the board reads; see managers/bluez_patch_status)
# ---------------------------------------------------------------------------

write_marker() {
    # write_marker <active> <healthy> [base_version]
    #   healthy=true  -> advertising was CONFIRMED working at decision time
    #                    (stock probed OK, or patch probed OK). Only a healthy
    #                    result lets the next run fast-skip.
    #   healthy=false -> degraded (stock broken and patch could not be built /
    #                    applied). The next run must re-evaluate, not skip.
    local active="$1" healthy="$2" base="${3:-$(bluez_version)}"
    mkdir -p "$STATE_DIR"
    python3 - "$MARKER" "$active" "$healthy" "$base" "$FIX_REF" "$FIX_REASON" \
             "$(kernel_release)" "$(arch)" <<'PY'
import json, sys, datetime
path, active, healthy, base, fix, reason, kernel, march = sys.argv[1:9]
doc = {
    "active": active,                      # stock | patched
    "patched": active == "patched",
    "healthy": healthy == "true",
    "base_version": base if base != "unknown" else None,
    "fix": fix if active == "patched" else None,
    "reason": reason if active == "patched" else None,
    "applied_at": datetime.datetime.now(datetime.timezone.utc).replace(
        microsecond=0, tzinfo=None).isoformat() + "Z",
    # Inputs this decision was made against; used for the fast no-op guard.
    "checked_bluez_version": base,
    "checked_kernel": kernel,
    "arch": march,
}
with open(path, "w", encoding="utf-8") as fh:
    json.dump(doc, fh, indent=2)
PY
    chmod 0644 "$MARKER" 2>/dev/null || true
    log "marker: active=$active healthy=$healthy base=$base kernel=$(kernel_release)"
}

marker_field() {
    # marker_field <key> -> value or empty
    [ -f "$MARKER" ] || return 0
    python3 - "$MARKER" "$1" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1]) as fh:
        print(json.load(fh).get(sys.argv[2], "") or "")
except Exception:
    pass
PY
}

# ---------------------------------------------------------------------------
# Progress (transient signal the board polls; see managers/bluez_patch_status).
# The marker above is the final outcome; this file says a heal is RUNNING right
# now and which phase, so the UI shows "self-heal in progress" instead of the
# bare ADV_FAILED stock BlueZ produces during the multi-minute rebuild.
# ---------------------------------------------------------------------------

HEAL_STARTED=""   # set on the first write_progress so started_at is the heal start

write_progress() {
    # write_progress <phase>  (phase must match managers/bluez_patch_status HEAL_*)
    local phase="$1"
    [ -n "$HEAL_STARTED" ] || HEAL_STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    mkdir -p "$STATE_DIR"
    python3 - "$PROGRESS" "$phase" "$HEAL_STARTED" <<'PY' 2>/dev/null || true
import json, sys
path, phase, started = sys.argv[1:4]
with open(path, "w", encoding="utf-8") as fh:
    json.dump({"running": True, "phase": phase, "started_at": started}, fh)
PY
    chmod 0644 "$PROGRESS" 2>/dev/null || true
    log "progress: $phase"
}

clear_progress() {
    # Remove the running record so the board's poll reverts to idle. Idempotent;
    # wired to the EXIT/INT/TERM trap so any exit (including the systemd timeout's
    # SIGTERM) cannot leave the UI stuck on a phantom "healing" state.
    rm -f "$PROGRESS" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Probe + diversion primitives
# ---------------------------------------------------------------------------

restart_bluetooth() {
    systemctl restart bluetooth 2>/dev/null || true
    # Give bluetoothd a moment to claim org.bluez before probing.
    sleep 3
}

restart_board() {
    # Restarting bluetoothd drops every advertisement the board service had
    # registered over D-Bus, and BleManager does not re-register on a bluetoothd
    # restart -- so after we change the stack the board would sit there NOT
    # advertising until something restarts it. Restart it here so it re-registers
    # against the now-current bluetoothd. try-restart only acts if it is running;
    # --no-block so a heal triggered from an apt hook does not wait on it.
    systemctl try-restart --no-block universal-chess.service 2>/dev/null || true
}

probe() {
    # 0 if advertising registers, 1 if BlueZ rejected it, 2 if it could not run.
    [ -x "$PROBE" ] || { log "probe helper missing at $PROBE"; return 2; }
    python3 "$PROBE"
}

probe_verdict() {
    # probe_verdict <exit-code> -> pass | fail | error
    #
    # Exit 2 (and anything unexpected) means the measurement could NOT BE MADE --
    # no D-Bus, bluetoothd not up yet, helper unusable. That is not evidence that
    # stock BlueZ is broken, so it must never authorize the rebuild: the daemon
    # build costs up to 45 minutes on a Pi Zero, and the run that follows an
    # inconclusive probe would have nothing to verify against. Collapsing error
    # into fail (the previous behaviour, a bare `if probe`) is exactly how a board
    # with no controller ended up compiling bluetoothd on every boot.
    case "$1" in
        0) echo pass ;;
        1) echo fail ;;
        *) echo error ;;
    esac
}

is_diverted() {
    local bd="$1"
    dpkg-divert --list "$bd" 2>/dev/null | grep -q "diversion of $bd"
}

retire_patch() {
    # Restore the stock bluetoothd (remove our diversion + binary). Idempotent.
    local bd="$1" stock="${1}.stock"
    if is_diverted "$bd"; then
        log "retiring patched bluetoothd; restoring stock"
        # Remove our installed binary so --rename can move the stock back.
        rm -f "$bd"
        dpkg-divert --remove --rename --divert "$stock" "$bd" || \
            log "WARNING: dpkg-divert --remove failed"
    fi
}

apply_patch() {
    # Divert stock aside and install the patched binary from $1. Idempotent, and
    # atomic on failure: if a step fails after the diversion was added, the
    # diversion is rolled back so the canonical path is never left without a
    # binary (which would leave Bluetooth unable to start at all).
    #
    # Crash-safety: STAGE the patched binary in the target dir FIRST, then (after
    # diverting stock aside) swap it into place with a single atomic rename. This
    # shrinks the window in which the canonical path has no file -- a power cut in
    # that window leaves Bluetooth unable to start until the boot safety net
    # restores stock -- from a whole file copy down to one rename.
    local patched="$1" bd="$2" stock="${2}.stock" staged="${2}.uc-new"
    if ! install -m 0755 "$patched" "$staged"; then
        log "ERROR: staging patched binary failed"; rm -f "$staged"; return 1
    fi
    if ! is_diverted "$bd"; then
        dpkg-divert --add --rename --divert "$stock" "$bd" || {
            log "ERROR: dpkg-divert --add failed"; rm -f "$staged"; return 1; }
    fi
    if ! mv -f "$staged" "$bd"; then
        log "ERROR: swapping patched binary into place failed; rolling back diversion"
        rm -f "$staged"
        retire_patch "$bd"
        return 1
    fi
    log "patched bluetoothd installed at $bd (stock at $stock)"
}

# ---------------------------------------------------------------------------
# Build the patched bluetoothd from THIS OS's own bluez source
# ---------------------------------------------------------------------------

# Enable deb-src for whatever repos are configured (best-effort, idempotent) so
# `apt-get source bluez` works. Mirrors deb822 .sources and classic .list lines.
enable_deb_src() {
    local out="/etc/apt/sources.list.d/uc-bluez-src.sources" had=0
    : > "${out}.tmp"
    local f
    for f in /etc/apt/sources.list.d/*.sources; do
        [ -e "$f" ] || continue
        if grep -qi '^Types:.*deb-src' "$f"; then had=1; continue; fi
        if grep -qi '^Types:.*deb' "$f"; then
            sed 's/^\(Types:\).*/\1 deb-src/I' "$f" >> "${out}.tmp"
            echo >> "${out}.tmp"
        fi
    done
    if [ -s "${out}.tmp" ]; then mv "${out}.tmp" "$out"; else rm -f "${out}.tmp"; fi
    # Classic single-line sources (older images).
    if [ -f /etc/apt/sources.list ] && grep -q '^deb ' /etc/apt/sources.list \
       && ! grep -q '^deb-src ' /etc/apt/sources.list; then
        sed -n 's/^deb /deb-src /p' /etc/apt/sources.list \
            > /etc/apt/sources.list.d/uc-bluez-src.list 2>/dev/null || true
    fi
    [ "$had" = 1 ] || log "enabled deb-src for bluez source"
}

build_patched() {
    # Echo the path to a (cached or freshly built) patched bluetoothd, or fail.
    local ver arch_ cached work src apt_lock
    ver="$(bluez_version)"; arch_="$(arch)"
    cached="${CACHE_DIR}/bluetoothd-${ver}-${arch_}"
    # Reuse the cache only if the binary is intact. A power cut mid-write can leave
    # a truncated file that still has the exec bit (so a bare -x check would reuse
    # a corrupt binary forever, looping the heal); a --version probe confirms it
    # actually runs. Drop a failed-probe binary so the build below replaces it.
    if [ -x "$cached" ] && timeout 5 "$cached" --version >/dev/null 2>&1; then
        log "using cached patched binary $cached"; echo "$cached"; return 0
    fi
    [ -e "$cached" ] && { log "cached binary $cached failed integrity check; rebuilding"; rm -f "$cached"; }

    mkdir -p "$CACHE_DIR"
    apt_lock="-o DPkg::Lock::Timeout=300"

    log "building patched bluetoothd from distro source (bluez $ver / $arch_)"
    enable_deb_src
    apt-get $apt_lock update >/dev/null 2>&1 || log "WARNING: apt-get update failed"
    if ! apt-get $apt_lock build-dep -y "$PKG_NAME" >/dev/null 2>&1; then
        log "ERROR: build-dep failed (offline or deb-src unavailable)"; return 1
    fi

    work="$(mktemp -d /tmp/uc-bluez.XXXXXX)" || return 1
    ( cd "$work" && apt-get $apt_lock source "$PKG_NAME" >/dev/null 2>&1 ) || {
        log "ERROR: apt-get source bluez failed"; rm -rf "$work"; return 1; }
    src="$(find "$work" -maxdepth 1 -type d -name 'bluez-*' | head -n1)"
    [ -d "$src" ] || { log "ERROR: bluez source dir not found"; rm -rf "$work"; return 1; }

    # The fix: both param_len lines read sizeof(struct mgmt_cp_add_advertising);
    # replace with sizeof(*cp). In refresh_legacy_adv cp IS mgmt_cp_add_advertising
    # (no-op, same size); in add_adv_params_callback cp is mgmt_cp_add_ext_adv_data
    # (the fix). Content-based (not line-numbered) so it survives source revisions.
    if ! grep -q 'sizeof(struct mgmt_cp_add_advertising) + adv_data_len' "$src/src/advertising.c"; then
        log "ERROR: advertising.c does not contain the expected pattern; aborting"
        rm -rf "$work"; return 1
    fi
    sed -i 's/sizeof(struct mgmt_cp_add_advertising) + adv_data_len/sizeof(*cp) + adv_data_len/g' \
        "$src/src/advertising.c"

    # Expand swap headroom for just the compile. bluetoothd's build can exceed a
    # 512MB board's RAM with make -j$(nproc); without the extra swap the OOM
    # killer aborts it and the heal never completes (a likely contributor to the
    # multi-tens-of-minutes worst case as the board thrashes). uc-build-memory
    # brings up zram + a temporary SD backstop and tears it down after; it is
    # reference-counted so it is safe even if an engine install is acquiring it
    # concurrently. Best-effort: if the helper is missing we still attempt the
    # build (prior behavior).
    local build_mem="${SCRIPT_DIR}/uc-build-memory"
    [ -x "$build_mem" ] && "$build_mem" acquire --owner-pid "$$" 2>/dev/null
    local jobs; jobs="$(build_jobs)"
    log "compiling bluetoothd with make -j${jobs} (RAM-aware) and LTO disabled"
    (
        cd "$src" || exit 1
        # Drop link-time optimization for this on-device rebuild. The patched
        # bluetoothd is a one-line functional fix (BLE advertising is unaffected by
        # optimization level), so LTO buys nothing here -- but the distro's default
        # -flto=auto makes the FINAL LINK the build's memory + time peak: it spawns
        # parallel lto1-ltrans processes that, on a ~415MB board, thrash swap for
        # tens of minutes (observed: load ~13, kswapd pegged, a >30min heal that
        # completed but crippled the board meanwhile). Removing it via
        # dpkg-buildflags (optimize=-lto, read by debian/rules -> dpkg-buildflags)
        # makes -j the only concurrency knob so build_jobs actually bounds the peak.
        export DEB_BUILD_MAINT_OPTIONS="optimize=-lto ${DEB_BUILD_MAINT_OPTIONS:-}"
        # BUILT_SOURCES (the lib/bluetooth header symlink + src/builtin.h) are only
        # generated for the default target, so create/generate them before building
        # the daemon target directly.
        [ -e lib/bluetooth ] || ln -sf . lib/bluetooth
        debian/rules override_dh_auto_configure >/dev/null 2>&1 || ./configure >/dev/null 2>&1 || exit 1
        make src/builtin.h obexd/src/builtin.h >/dev/null 2>&1 || true
        make -j"${jobs}" src/bluetoothd >/dev/null 2>&1 || exit 1
    )
    local compile_rc=$?
    [ -x "$build_mem" ] && "$build_mem" release --owner-pid "$$" 2>/dev/null
    [ "$compile_rc" -eq 0 ] || { log "ERROR: compile failed"; rm -rf "$work"; return 1; }

    [ -x "$src/src/bluetoothd" ] || { log "ERROR: bluetoothd not produced"; rm -rf "$work"; return 1; }
    # Write the cache atomically: install to a temp then rename, so a power cut
    # mid-write can never leave a truncated binary at $cached (which the reuse
    # check would otherwise have to catch). Rename is atomic within the same dir.
    if ! install -m 0755 "$src/src/bluetoothd" "${cached}.tmp"; then
        log "ERROR: caching built binary failed"; rm -f "${cached}.tmp"; rm -rf "$work"; return 1
    fi
    mv -f "${cached}.tmp" "$cached"
    rm -rf "$work"
    log "built + cached patched binary at $cached"
    echo "$cached"
}

# ---------------------------------------------------------------------------
# Main decision
# ---------------------------------------------------------------------------

main() {
    # Nothing to heal on a board with no Bluetooth controller: no bluetoothd, stock
    # or patched, can advertise without hardware. Checked FIRST -- ahead of the
    # state dir, the lock, and every systemctl call -- so an unequipped board pays
    # nothing and cannot fail on any of them. Deliberately writes no marker: the
    # marker describes which bluetoothd is active, and there is no decision to
    # record here. Exits 0 so systemd does not flag the unit on a board that is
    # simply not equipped; attach a USB dongle and the next run heals normally.
    if ! has_bluetooth_adapter; then
        clear_progress
        log "no Bluetooth controller present (e.g. a Raspberry Pi Zero without wireless) -- nothing to heal"
        exit 0
    fi

    mkdir -p "$STATE_DIR"
    # Serialize against concurrent apt-triggered runs; wait up to 10 min.
    exec 9>"$LOCK"
    flock -w 600 9 || { log "another self-heal run holds the lock; exiting"; exit 0; }

    # Any exit from here on clears the progress file so the board's poll reverts
    # to idle. Also clear it on ENTRY: a record present now can only be stale
    # (a prior run died without its trap firing -- e.g. a hard power cut), and a
    # fast-skip exit below would otherwise leave it pinned on "Repairing...".
    trap on_exit EXIT INT TERM
    clear_progress

    local bd ver kern active
    bd="$(detect_bluetoothd)"
    ver="$(bluez_version)"; kern="$(kernel_release)"

    # Fast no-op: skip ONLY when the last decision was confirmed healthy AND the
    # inputs (bluez version, kernel) are unchanged. A degraded marker
    # (healthy=false, e.g. stock broken but patch could not be built) must NOT
    # fast-skip -- it re-evaluates so a later online run can heal it.
    if [ "$(marker_field healthy)" = "True" ] \
       && [ "$(marker_field checked_bluez_version)" = "$ver" ] \
       && [ "$(marker_field checked_kernel)" = "$kern" ]; then
        active="$(marker_field active)"
        if [ "$active" = "stock" ]; then
            log "unchanged (bluez $ver, kernel $kern); stock healthy -- nothing to do"; exit 0
        fi
        if [ "$active" = "patched" ] && is_diverted "$bd"; then
            log "unchanged (bluez $ver, kernel $kern); patch still applied -- nothing to do"; exit 0
        fi
        # active=patched but diversion gone (e.g. bluez reinstall): fall through.
    fi

    # Real work begins here (past the fast no-op skip): start the heal timer so
    # the EXIT trap emits a timed event. Skipped/no-op boots leave it unset.
    HEAL_START="$(date +%s)"
    log "evaluating bluez $ver on kernel $kern (bluetoothd=$bd)"

    # Always evaluate against STOCK first so the patch auto-retires when the
    # distro catches up.
    # From here on we restart bluetoothd at least once, dropping the board's
    # advertisements; every terminal path therefore restarts the board service so
    # it re-registers against the resulting bluetoothd.
    write_progress probing-stock
    retire_patch "$bd"
    restart_bluetooth
    probe
    local probe_rc=$?
    local verdict
    verdict="$(probe_verdict "$probe_rc")"
    case "$verdict" in
        pass)
            log "stock bluetoothd advertises correctly -- no patch needed"
            write_marker stock true "$ver"
            restart_board
            exit 0
            ;;
        error)
            # Inconclusive, not broken. Record the decision as NOT healthy so the
            # next run (boot or apt) re-evaluates instead of fast-skipping, but do
            # not build: there is no measurement to justify substituting a binary.
            log "ERROR: could not probe advertising (no bus / bluetoothd unavailable) -- not patching"
            write_marker stock false "$ver"
            restart_board
            exit 1
            ;;
    esac
    log "stock bluetoothd FAILS to advertise on this kernel -- patching"

    local patched
    write_progress building
    patched="$(build_patched)" || {
        log "ERROR: could not build patched bluetoothd; leaving stock in place"
        write_marker stock false "$ver"
        restart_board
        exit 1
    }

    write_progress applying
    if ! apply_patch "$patched" "$bd"; then
        write_marker stock false "$ver"
        restart_board
        exit 1
    fi
    write_progress probing-patch
    restart_bluetooth
    if probe; then
        log "patched bluetoothd advertises correctly"
        write_marker patched true "$ver"
        restart_board
        exit 0
    fi

    log "ERROR: patched bluetoothd still fails; rolling back to stock"
    retire_patch "$bd"
    restart_bluetooth
    write_marker stock false "$ver"
    restart_board
    exit 1
}

boot() {
    # Boot-time safety net. The apply/retire heal is normally install/apt-driven,
    # but a reboot BEFORE a first-time heal finishes -- notably the fresh-install
    # reboot in our postinst interrupting the on-board bluetoothd build -- would
    # otherwise leave stock BlueZ broken with nothing to re-trigger it. Re-run the
    # heal at boot ONLY when the last decision is missing or degraded: a confirmed
    # healthy marker means a prior install/apt run already settled it (an input
    # change such as an OS upgrade goes through apt, which re-triggers via the APT
    # hook), so a healthy boot does ZERO probing or bluetoothd restarts here.
    #
    # First clear any progress record: at boot it is always stale (no heal can
    # survive a reboot), so this guarantees the UI is not pinned on "Repairing..."
    # even on the healthy-skip path below that never enters main().
    clear_progress
    if [ "$(marker_field healthy)" = "True" ]; then
        log "boot: last self-heal was healthy -- nothing to do"
        exit 0
    fi
    log "boot: marker absent or degraded -- running self-heal"
    main
}

case "${1:-run}" in
    run)           main ;;
    boot)          boot ;;                                  # boot-time safety net (gated)
    probe-only)    probe ;;                                 # diagnostics
    probe-verdict) probe_verdict "${2:-}" ;;                # diagnostics: exit code -> decision
    has-adapter)   has_bluetooth_adapter ;;                 # diagnostics: is a controller fitted
    build-jobs)    build_jobs ;;                            # diagnostics: computed compile parallelism
    retire)        retire_patch "$(detect_bluetoothd)"; restart_bluetooth; restart_board; write_marker stock false ;;
    status)        cat "$MARKER" 2>/dev/null || echo "{}" ;;
    *)             echo "usage: bluez-selfheal {run|boot|probe-only|probe-verdict <rc>|has-adapter|build-jobs|retire|status}" >&2; exit 2 ;;
esac
