#!/bin/sh
# Root helper that installs a Universal Chess update .deb.
#
# Invoked by the update service through a single pinned, passwordless sudo
# grant installed by the package postinst:
#
#   <service-user> ALL=(root) NOPASSWD: /opt/universalchess/scripts/install-update
#
# Why a fixed helper instead of NOPASSWD on systemd-run/apt directly:
# granting the service user passwordless sudo on a general-purpose tool
# (systemd-run, apt) is equivalent to handing it unrestricted root. A pinned
# helper narrows the privilege to exactly one operation -- "install a .deb that
# we ourselves downloaded into the managed pending-updates directory" -- and
# refuses anything else. The directory check below is the security boundary for
# the grant; do not loosen it.
#
# Why the install runs in a transient systemd unit: the package postinst
# restarts universal-chess.service and universal-chess-web.service, both of
# which use KillMode=control-group. Anything left in the triggering service's
# cgroup (even a setsid-detached child) is killed mid-install. systemd-run
# places the work in its own cgroup owned by PID 1, so it survives the restart.
# A fixed unit name also gives cross-process mutual exclusion: systemd-run
# refuses to start a second install while one is active.
set -eu

PENDING_DIR="/opt/universalchess/pending-updates"
STATE_FILE="/opt/universalchess/update-state.json"
LOG="/var/log/universal-chess-update.log"
UNIT="universal-chess-update"
SELF="/opt/universalchess/scripts/install-update"
PACKAGE="universal-chess"

# Integrity inputs. PENDING_DIR is writable by the service user by design (the
# updater downloads into it), so nothing in there is trusted on its own: the
# MANIFEST and SIGNATURE are attacker-controllable, and only the KEYRING -- which
# lives in the root-owned install tree and ships in the package -- is not. The
# signature is what makes the manifest trustworthy, and the manifest is what makes
# the .deb's checksum meaningful. Verifying a checksum supplied by the same party
# that supplied the .deb would prove nothing.
KEYRING="/opt/universalchess/keys/release-signing.gpg"
MANIFEST="${PENDING_DIR}/SHA256SUMS.txt"
SIGNATURE="${MANIFEST}.asc"

# Parse arguments. "--run" means we have already been re-exec'd inside the
# transient unit (as root, by systemd) and should perform the actual install.
# "--allow-channel-switch" permits installing an older version, which a
# stable<->nightly switch legitimately requires.
MODE="launch"
ALLOW_CHANNEL_SWITCH=0
DEB=""
while [ $# -gt 0 ]; do
    case "$1" in
        --run) MODE="run" ;;
        --allow-channel-switch) ALLOW_CHANNEL_SWITCH=1 ;;
        --) shift; break ;;
        -*)
            echo "unknown option: $1" >&2
            exit 2
            ;;
        *)
            if [ -n "$DEB" ]; then
                echo "unexpected argument: $1" >&2
                exit 2
            fi
            DEB="$1"
            ;;
    esac
    shift
done
# Anything after `--` is the deb path, if not already given.
if [ -z "$DEB" ] && [ $# -gt 0 ]; then
    DEB="$1"
fi

if [ -z "$DEB" ]; then
    echo "usage: install-update [--run] [--allow-channel-switch] <deb-path>" >&2
    exit 2
fi

# Security boundary: canonicalize the path (resolving any '..') and require it
# to live directly inside the managed pending-updates directory. Validated in
# BOTH modes so a caller cannot pass "--run <arbitrary path>" to escape it.
REAL_DEB="$(readlink -f -- "$DEB" 2>/dev/null || true)"
case "$REAL_DEB" in
    "$PENDING_DIR"/*.deb) : ;;
    *)
        echo "refusing to install outside $PENDING_DIR: $DEB" >&2
        exit 2
        ;;
esac
if [ ! -f "$REAL_DEB" ]; then
    echo "deb not found: $REAL_DEB" >&2
    exit 2
fi

if [ "$MODE" = "launch" ]; then
    # Re-exec inside a transient unit so the install survives the service
    # restart performed by the postinst. Already root here, so no nested sudo.
    # The channel-switch decision is forwarded rather than re-derived, so the
    # re-exec installs under exactly the policy the caller was granted.
    if [ "$ALLOW_CHANNEL_SWITCH" -eq 1 ]; then
        exec systemd-run --collect --unit="$UNIT" \
            "$SELF" --run --allow-channel-switch "$REAL_DEB"
    fi
    exec systemd-run --collect --unit="$UNIT" "$SELF" --run "$REAL_DEB"
fi

# --- MODE=run: the actual install, inside the transient unit, as root ---
exec >>"$LOG" 2>&1
export DEBIAN_FRONTEND=noninteractive
echo "$(date): [update] install start: $REAL_DEB"

# --- Integrity gate: must pass before the package is allowed to run any code ---
#
# Ordering is the whole point. A .deb's maintainer scripts execute as root during
# installation, so verification that happens afterwards protects nothing.
#
# Every input except the keyring is service-user writable, so each absence is a
# refusal rather than a reason to skip the check: an attacker who could turn
# verification off by deleting the signature would face no verification at all.
for required in "$KEYRING" "$MANIFEST" "$SIGNATURE"; do
    if [ ! -f "$required" ]; then
        echo "$(date): [update] REFUSED: missing verification input: $required"
        exit 1
    fi
done

# Verify with whichever single-purpose verifier the system has. Which one is
# guaranteed depends on the Debian release: bookworm's apt depends on gpgv, while
# trixie's apt is built against Sequoia and depends on sqv instead, so gpgv can be
# absent there. Using either means the tool is already installed on both and the
# update needs no network to verify itself.
#
# Both are used rather than gpg because they verify against a fixed keyring,
# never mutate it and need no GNUPGHOME -- the same job apt does. A forged
# manifest fails here because the service user cannot produce a valid signature.
#
# The keyring must be a plain OpenPGP certificate stream (what `gpg --export`
# writes), not a GnuPG keybox: sqv cannot parse the keybox format.
verify_manifest_signature() {
    if command -v sqv > /dev/null 2>&1; then
        if sqv --keyring="$KEYRING" --signature-file="$SIGNATURE" "$MANIFEST" > /dev/null 2>&1; then
            return 0
        fi
        return 1
    fi
    if command -v gpgv > /dev/null 2>&1; then
        if gpgv --keyring "$KEYRING" "$SIGNATURE" "$MANIFEST" > /dev/null 2>&1; then
            return 0
        fi
        return 1
    fi
    # No verifier at all must refuse, never fall through to an unverified install:
    # otherwise removing the binary would be enough to disable the check.
    echo "$(date): [update] REFUSED: no OpenPGP verifier (sqv or gpgv) installed"
    return 1
}

if ! verify_manifest_signature; then
    echo "$(date): [update] REFUSED: manifest signature is not valid"
    exit 1
fi
echo "$(date): [update] manifest signature verified"

# With the manifest now trusted, the .deb must match the checksum it publishes for
# that exact filename.
DEB_NAME="$(basename "$REAL_DEB")"
EXPECTED_SHA="$(awk -v name="$DEB_NAME" '$2 == name || $2 == "*" name {print $1; exit}' "$MANIFEST")"
if [ -z "$EXPECTED_SHA" ]; then
    echo "$(date): [update] REFUSED: $DEB_NAME is not listed in the signed manifest"
    exit 1
fi
ACTUAL_SHA="$(sha256sum "$REAL_DEB" | awk '{print $1}')"
if [ "$EXPECTED_SHA" != "$ACTUAL_SHA" ]; then
    echo "$(date): [update] REFUSED: checksum mismatch for $DEB_NAME"
    echo "$(date): [update]   expected $EXPECTED_SHA"
    echo "$(date): [update]   actual   $ACTUAL_SHA"
    exit 1
fi
echo "$(date): [update] package checksum verified"

# Rollback guard. A signature proves the package is genuine, not that it is
# current -- a genuine older release would reintroduce whatever it was that the
# newer one fixed, and every check above would still pass. Skipped for a declared
# channel switch, where moving to a lower version is the intent.
CANDIDATE_VERSION="$(dpkg-deb -f "$REAL_DEB" Version 2>/dev/null || true)"
INSTALLED_VERSION="$(dpkg-query -W -f='${Version}' "$PACKAGE" 2>/dev/null || true)"
if [ "$ALLOW_CHANNEL_SWITCH" -eq 0 ] && [ -n "$CANDIDATE_VERSION" ] && [ -n "$INSTALLED_VERSION" ]; then
    if dpkg --compare-versions "$CANDIDATE_VERSION" lt "$INSTALLED_VERSION"; then
        echo "$(date): [update] REFUSED: $CANDIDATE_VERSION is older than installed $INSTALLED_VERSION"
        echo "$(date): [update]   pass --allow-channel-switch for a deliberate channel change"
        exit 1
    fi
fi

# Refresh package lists so a newly added dependency can be resolved from the
# repos. Tolerate failure (e.g. offline) and fall back to cached lists.
apt-get update || echo "$(date): [update] apt-get update failed (continuing)"

# Finish any dpkg transaction that a previous (often unrelated) operation left
# interrupted. A killed/aborted apt run -- e.g. a manual `apt build-dep` or a
# reboot mid-install -- leaves the dpkg database half-configured, and EVERY
# subsequent apt operation then aborts during "Reading package lists" with
# "E: dpkg was interrupted, you must manually run 'dpkg --configure -a'". That
# bricks the OTA even though the update .deb is fine (observed on a field
# board). The apt `-f` install below does NOT clear this state -- only
# `dpkg --configure -a` completes the interrupted transaction -- so it must run
# BEFORE the apt step, which would otherwise abort before reaching it.
# Tolerate failure so a genuinely broken package surfaces as the apt error
# below rather than being masked here.
dpkg --configure -a || echo "$(date): [update] dpkg --configure -a failed (continuing)"

# apt resolves dependencies in a single atomic transaction. Flags (do not drop):
#   -f/--fix-broken    repair a system left half-configured by a previously
#                      interrupted install, and pull the package's missing
#                      dependencies in the same transaction. A direct dpkg
#                      install is dependency-unaware and leaves the package
#                      half-configured on a missing dependency -- the failure
#                      that bricked an earlier update.
#   --reinstall        every nightly carries the same dpkg version
#                      ("2.0.0-nightly"); without this apt sees it as already
#                      installed and does nothing.
#   --allow-downgrades covers channel switches where the candidate sorts lower
#                      than the installed version.
if apt-get install -y -f --reinstall --allow-downgrades "$REAL_DEB"; then
    echo "$(date): [update] install succeeded"
else
    echo "$(date): [update] install FAILED"
    exit 1
fi

# Clear the pending marker so the board does not attempt a reinstall on boot.
python3 - "$STATE_FILE" <<'PYEOF' || true
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
try:
    s = json.loads(p.read_text())
    s["pending_deb"] = None
    s["available_version"] = None
    s["available_release_tag"] = None
    p.write_text(json.dumps(s, indent=2))
except Exception:
    pass
PYEOF

echo "$(date): [update] complete"
